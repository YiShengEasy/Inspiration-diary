# Default third-party AI API.
# Use an OpenAI-compatible gateway such as Doubao/Volcengine Ark, DeepSeek, Qwen, or another provider.
THIRD_PARTY_BASE_URL="https://ark.cn-beijing.volces.com/api/v3"
THIRD_PARTY_API_KEY="YOUR_THIRD_PARTY_API_KEY"
THIRD_PARTY_MODEL="doubao-seed-2.0-code"
THIRD_PARTY_THINKING=false

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Anthropic API parameters (optional override)
ANTHROPIC_BASE_URL="https://api.anthropic.com"
ANTHROPIC_AUTH_TOKEN="YOUR_ANTHROPIC_API_KEY"

# Database Configuration (Compatibility Layer)
# Set VITE_DATABASE_TYPE to "postgres" on the client, and DATABASE_TYPE to "postgres" on the server
# to bypass Firestore and save/load notes & aesthetic polaroids in your local PostgreSQL database instead.
VITE_DATABASE_TYPE="firestore" # Options: "firestore" (default), "postgres"
DATABASE_TYPE="firestore"      # Options: "firestore" (default), "postgres"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/notebook"
DATABASE_SSL="false"           # Use "true" if your local or hosted Postgres database requires SSL

# Local Authentication
AUTH_SESSION_DAYS=7
AUTH_COOKIE_SECURE=false
AUTH_BOOTSTRAP_EMAIL=local-admin@example.com
AUTH_BOOTSTRAP_PASSWORD=

# PhotoPrism Image Storage
# Server-side only. Do not expose the password in frontend code.
PHOTOPRISM_INTERNAL_URL="http://host.docker.internal:2342"
PHOTOPRISM_PUBLIC_URL="http://localhost:2342"
PHOTOPRISM_USERNAME="admin"
PHOTOPRISM_PASSWORD="<server-side-secret>"
MEDIA_DELIVERY_MODE=proxy
OSS_THUMB_240_PROCESS=image/resize,w_240/quality,Q_70/format,webp
OSS_THUMB_480_PROCESS=image/resize,w_480/quality,Q_75/format,webp
OSS_DETAIL_1280_PROCESS=image/resize,w_1280/quality,Q_82/format,webp
OSS_VIDEO_POSTER_PROCESS=video/snapshot,t_1000,f_jpg,w_720
