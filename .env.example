# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Anthropic API parameters (optional override)
ANTHROPIC_BASE_URL="https://api.anthropic.com"
ANTHROPIC_AUTH_TOKEN="YOUR_ANTHROPIC_API_KEY"

# Database Configuration (Compatibility Layer)
# Set VITE_DATABASE_TYPE to "postgres" on the client, and DATABASE_TYPE to "postgres" on the server
# to bypass Firestore and save/load notes & aesthetic polaroids in your local PostgreSQL database instead.
VITE_DATABASE_TYPE="firestore" # Options: "firestore" (default), "postgres"
DATABASE_TYPE="firestore"      # Options: "firestore" (default), "postgres"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/notebook"
DATABASE_SSL="false"           # Use "true" if your local or hosted Postgres database requires SSL

