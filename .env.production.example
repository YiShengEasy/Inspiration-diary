APP_ENV=production
DEPLOYMENT_PROFILE=production
NODE_ENV=production
PORT=3005

THIRD_PARTY_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
THIRD_PARTY_API_KEY=CHANGE_ME_THIRD_PARTY_API_KEY
THIRD_PARTY_MODEL=doubao-seed-2.0-code
THIRD_PARTY_THINKING=false
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_AUTH_TOKEN=

VITE_DATABASE_TYPE=postgres
DATABASE_TYPE=postgres
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
DATABASE_URL=postgresql://inspiration:CHANGE_ME_POSTGRES_PASSWORD@127.0.0.1:5432/notebook
DATABASE_SSL=false

AUTH_SESSION_DAYS=7
AUTH_COOKIE_SECURE=true
# Temporary only when testing production over plain HTTP/IP. Keep false or remove after HTTPS is enabled.
ALLOW_INSECURE_COOKIE=false
AUTH_BOOTSTRAP_EMAIL=admin@example.com
AUTH_BOOTSTRAP_PASSWORD=

IMAGE_STORAGE_PROVIDER=oss
VIDEO_STORAGE_PROVIDER=oss
IMAGE_ASSET_STORAGE_PROVIDER=oss

OSS_REGION=oss-cn-hangzhou
OSS_BUCKET=CHANGE_ME_BUCKET
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
OSS_ACCESS_KEY_ID=CHANGE_ME_RAM_ACCESS_KEY_ID
OSS_ACCESS_KEY_SECRET=CHANGE_ME_RAM_ACCESS_KEY_SECRET
OSS_PUBLIC_BASE_URL=https://CHANGE_ME_BUCKET.oss-cn-hangzhou.aliyuncs.com
OSS_SIGNED_URL_TTL_SECONDS=900
MEDIA_DELIVERY_MODE=proxy
OSS_THUMB_240_PROCESS=image/resize,w_240/quality,Q_70/format,webp
OSS_THUMB_480_PROCESS=image/resize,w_480/quality,Q_75/format,webp
OSS_DETAIL_1280_PROCESS=image/resize,w_1280/quality,Q_82/format,webp
OSS_VIDEO_POSTER_PROCESS=video/snapshot,t_1000,f_jpg,w_720

# Roll out as off -> admin -> all. admin/all require the restricted RAM role ARN.
# Never expose OSS_ACCESS_KEY_ID or OSS_ACCESS_KEY_SECRET to browser code.
WEB_DIRECT_OSS_UPLOAD_MODE=off
KNOWLEDGE_BASE_ENABLED=false
KNOWLEDGE_AI_RELATIONS_ENABLED=false
OSS_STS_ROLE_ARN=
UPLOAD_AUTH_TTL_SECONDS=900
UPLOAD_VIDEO_STS_TTL_SECONDS=900
UPLOAD_ACTIVE_SESSIONS_PER_USER=5
UPLOAD_AUTHORIZATIONS_PER_MINUTE=20
UPLOAD_MAX_IMAGE_BYTES=26214400
UPLOAD_MAX_DOCUMENT_BYTES=20971520
UPLOAD_MAX_VIDEO_BYTES=104857600
UPLOAD_MAX_ANALYSIS_BYTES=5242880

VIDEO_UPLOAD_ROOT=/app/uploads/videos
IMAGE_ASSET_UPLOAD_ROOT=/app/uploads/images

MINI_DEBUG_PASSWORD_LOGIN=false
WECHAT_MOCK=false
WECHAT_MINI_APP_ID=CHANGE_ME_WECHAT_MINI_APP_ID
WECHAT_MINI_APP_SECRET=your-wechat-mini-app-secret
