.qr-page { min-height:100vh; padding:28rpx 31rpx 120rpx; box-sizing:border-box; background:#fff; color:#151712; }
button { margin:0; padding:0; border:0; line-height:1; }
button::after { border:0; }
.hero-card { position:relative; overflow:hidden; min-height:210rpx; padding:34rpx; box-sizing:border-box; border-radius:34rpx; background:linear-gradient(118deg,#e9edff,#ded4ff 52%,#d9f8ec); }
.hero-card::after { content:""; position:absolute; right:-25rpx; top:-70rpx; width:240rpx; height:230rpx; border-radius:76rpx; background:rgba(183,255,56,.38); transform:rotate(13deg); }
.hero-kicker,.hero-title,.hero-desc { position:relative; z-index:1; display:block; }
.hero-kicker { color:#5742c8; font-size:20rpx; line-height:24rpx; font-weight:900; }
.hero-title { margin-top:12rpx; font-size:49rpx; line-height:55rpx; font-weight:950; }
.hero-desc { width:450rpx; margin-top:13rpx; color:rgba(28,27,62,.62); font-size:21rpx; line-height:29rpx; }
.mode-tabs { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:9rpx; margin-top:27rpx; padding:7rpx; border-radius:999rpx; background:#f1f2ed; }
.mode-button { display:flex; align-items:center; justify-content:center; min-height:62rpx; border-radius:999rpx; background:transparent; color:#73786f; font-size:20rpx; font-weight:900; }
.mode-button.active { background:#111; color:#b7ff38; }
.editor-head { display:flex; align-items:center; justify-content:space-between; margin:31rpx 0 15rpx; }
.section-title { display:block; font-size:29rpx; line-height:35rpx; font-weight:950; }
.head-actions { display:flex; gap:9rpx; }
.head-button { display:flex; align-items:center; justify-content:center; padding:13rpx 18rpx; border-radius:999rpx; background:#f2f3ee; color:#646960; font-size:18rpx; font-weight:850; }
.text-box { position:relative; min-height:230rpx; padding:20rpx 20rpx 42rpx; box-sizing:border-box; border-radius:27rpx; background:#f7f7f4; }
.content-input { width:100%; min-height:180rpx; color:#191b17; font-size:23rpx; line-height:34rpx; }
.content-count { position:absolute; right:18rpx; bottom:13rpx; color:#92978e; font-size:16rpx; }
.primary-button,.scan-button { display:flex; align-items:center; justify-content:center; width:100%; min-height:88rpx; margin-top:20rpx; border-radius:27rpx; background:#111; color:#b7ff38; font-size:25rpx; font-weight:950; }
.primary-button[disabled] { opacity:.5; }
.result-card { margin-top:26rpx; padding:25rpx; border-radius:29rpx; background:linear-gradient(145deg,#f1ffdd,#fbfff5); }
.qr-image { display:block; width:440rpx; height:440rpx; margin:0 auto; border-radius:20rpx; background:#fff; }
.save-button { display:flex; align-items:center; justify-content:center; width:100%; min-height:76rpx; margin-top:19rpx; border-radius:22rpx; background:#b7ff38; color:#111; font-size:23rpx; font-weight:950; }
.scan-card { margin-top:28rpx; padding:48rpx 34rpx 34rpx; border-radius:31rpx; text-align:center; background:#f7f7f4; }
.scan-icon,.scan-title,.scan-desc { display:block; }
.scan-icon { font-size:86rpx; line-height:1; font-weight:950; }
.scan-title { margin-top:22rpx; font-size:29rpx; line-height:35rpx; font-weight:950; }
.scan-desc { width:420rpx; margin:12rpx auto 0; color:#81867d; font-size:20rpx; line-height:28rpx; }
.scan-button { margin-top:29rpx; }
.scan-result { margin-top:25rpx; padding:25rpx; border-radius:28rpx; background:#f3ffdf; }
.scan-content { display:block; max-height:220rpx; margin-top:15rpx; overflow:auto; color:#353832; font-size:21rpx; line-height:31rpx; word-break:break-all; }
.result-actions { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:11rpx; margin-top:21rpx; }
.secondary-button { display:flex; align-items:center; justify-content:center; min-height:70rpx; border-radius:21rpx; background:#fff; color:#62675e; font-size:19rpx; font-weight:900; }
.secondary-button.active { background:#b7ff38; color:#111; }
.offscreen-canvas { position:fixed; left:-10000px; top:-10000px; width:1px; height:1px; opacity:0; pointer-events:none; }
