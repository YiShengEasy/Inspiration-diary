<view class="editor-page">
  <view class="editor-header">
    <button class="header-button icon-button" hover-class="button-press" hover-stay-time="80" bindtap="handleHeaderBack">
      <text class="button-icon back-icon">‹</text>
      <text class="button-text">返回</text>
    </button>
    <view class="header-title">
      <text class="title">{{tool === 'pixel' ? (beadStage === 'crop' ? '裁剪图片' : '拼豆图纸') : toolName}}</text>
      <text class="subtitle">{{tool === 'pixel' ? (beadStage === 'crop' ? '选择生成区域' : beadPatternSummary) : toolDesc}}</text>
    </view>
    <button wx:if="{{tool === 'pixel' && beadStage === 'crop'}}" class="header-button next-button" hover-class="button-press" hover-stay-time="80" bindtap="nextBeadStep">
      <text>下一步</text>
    </button>
    <button wx:elif="{{needsImage}}" class="header-button icon-button" hover-class="button-press" hover-stay-time="80" bindtap="chooseImage">
      <text class="button-icon">↻</text>
      <text class="button-text">{{tool === 'pixel' ? '导入' : '换图'}}</text>
    </button>
    <view wx:else class="header-spacer"></view>
  </view>

  <view class="editor-canvas">
    <view wx:if="{{showImagePreview}}" class="preview-frame {{tool === 'pixel' ? (beadStage === 'crop' ? beadCropFrameClass : 'bead-pattern-frame') : (tool === 'crop' ? imageEditorFrameClass : cropRatioClass)}} {{tool === 'crop' ? 'image-editor-frame' : ''}} {{tool === 'pixel' && beadStage === 'crop' ? 'pixel-crop-frame image-editor-frame' : ''}}" bindtouchstart="onBeadCropStart" catchtouchmove="onBeadCropMove">
      <image class="preview-image {{tool === 'crop' ? imageEditorImageClass : ''}}" style="{{tool === 'crop' ? imageEditorStyle : (tool === 'pixel' && beadStage === 'crop' ? beadCropImageStyle : '')}}" src="{{displayPath}}" mode="{{tool === 'pixel' && beadStage === 'pattern' ? 'aspectFit' : 'aspectFit'}}" data-src="{{displayPath}}" binderror="onPreviewImageError"></image>
      <view wx:if="{{previewClass}}" class="effect-overlay {{previewClass}}"></view>
      <view wx:if="{{(tool === 'crop' && imageEditMode === 'crop') || (tool === 'pixel' && beadStage === 'crop')}}" class="crop-guides"></view>
      <view wx:if="{{tool === 'crop' || (tool === 'pixel' && beadStage === 'crop')}}" class="edit-border">
        <text class="handle top"></text>
        <text class="handle right"></text>
        <text class="handle bottom"></text>
        <text class="handle left"></text>
      </view>
      <view wx:if="{{tool === 'pixel' && beadStage === 'pattern'}}" class="bead-left-toolbar">
        <button bindtap="backToBeadCrop">⌃</button>
        <button class="disabled">✋</button>
        <button class="active">✎</button>
        <button class="disabled">⌫</button>
        <button class="disabled">▣</button>
        <text>A1</text>
      </view>
      <view wx:if="{{tool === 'pixel' && beadGenerating}}" class="bead-generating">
        <text>生成中...</text>
      </view>
      <text wx:if="{{tool === 'crop' && operationStatus}}" class="restore-badge">{{operationStatus}}</text>
      <text wx:if="{{tool === 'watermark' && watermarkText}}" class="watermark-mark watermark-{{watermarkPosition}}">{{watermarkText}}</text>
      <view wx:if="{{tool === 'colorPick' || tool === 'palette' || tool === 'gradient'}}" class="floating-palette">
        <text wx:for="{{swatches}}" wx:key="*this" style="background: {{item}};"></text>
      </view>
    </view>

    <view wx:elif="{{needsImage}}" class="empty-preview" bindtap="chooseImage">
      <view class="empty-mark">
        <text>+</text>
      </view>
      <text class="empty-title">选择一张图片</text>
      <text class="empty-desc">上传后留在当前工具继续操作</text>
    </view>

    <view wx:else class="utility-preview">
      <view wx:if="{{tool === 'rgbhex'}}" class="color-result" style="background: {{hexValue}};">
        <text>{{hexValue}}</text>
      </view>
      <view wx:elif="{{tool === 'contrast'}}" class="contrast-result" style="background: {{contrastBg}}; color: {{contrastFg}};">
        <text class="contrast-demo">灵感日记</text>
        <text class="contrast-score">{{contrastScore}} · {{contrastLevel}}</text>
      </view>
      <view wx:else class="more-preview">
        <text class="more-preview-icon">{{toolIcon}}</text>
        <text>选择下方工具继续操作</text>
      </view>
    </view>

    <view class="canvas-badge">
      <text class="tool-icon">{{toolIcon}}</text>
      <text>{{toolName}}</text>
    </view>
  </view>

  <view class="controls {{tool === 'crop' ? 'image-edit-sheet' : ''}} {{tool === 'pixel' ? (beadStage === 'pattern' ? 'bead-result-sheet' : 'bead-crop-sheet') : ''}}">
    <view class="control-head">
      <view>
        <text class="control-title">{{controlTitle}}</text>
        <text class="control-desc">{{controlDesc}}</text>
      </view>
      <button wx:if="{{needsImage}}" class="choose-button" hover-class="button-press" hover-stay-time="80" bindtap="chooseImage">
        <text class="button-icon">＋</text>
        <text>选择图片</text>
      </button>
    </view>

    <view wx:if="{{tool === 'crop'}}" class="tool-panel image-edit-panel">
      <view class="image-edit-options">
        <block wx:if="{{imageEditMode === 'crop'}}">
          <button wx:for="{{cropOptions}}" wx:key="value" class="edit-option {{selectedCrop === item.value ? 'active' : ''}}" data-value="{{item.value}}" data-label="{{item.label}}" bindtap="setCrop">
            <text class="edit-option-icon icon-crop-{{item.value}}"></text>
            <text>{{item.label}}</text>
          </button>
        </block>
        <block wx:elif="{{imageEditMode === 'expand'}}">
          <button wx:for="{{expandOptions}}" wx:key="value" class="edit-option {{selectedExpand === item.value ? 'active' : ''}}" data-value="{{item.value}}" data-label="{{item.label}}" bindtap="setExpand">
            <text class="edit-option-icon icon-expand-{{item.value}}"></text>
            <text>{{item.label}}</text>
          </button>
        </block>
        <block wx:elif="{{imageEditMode === 'rotate'}}">
          <view class="rotate-wheel" bindtouchstart="onRotateWheelStart" catchtouchmove="onRotateWheelMove" bindtouchend="onRotateWheelEnd" bindtouchcancel="onRotateWheelEnd">
            <view class="wheel-window">
              <view class="wheel-arc" style="{{rotateWheelStyle}}">
                <view wx:for="{{rotateMarks}}" wx:key="angle" class="wheel-mark {{item.major ? 'major' : ''}}" style="{{item.markStyle}}">
                  <text wx:if="{{item.label}}" style="{{item.labelStyle}}">{{item.label}}</text>
                </view>
              </view>
            </view>
            <view class="wheel-pointer"></view>
            <text class="wheel-angle">{{rotationFineAngle}}°</text>
          </view>
          <button wx:for="{{rotateOptions}}" wx:key="value" class="edit-option {{(item.value === 'flipX' && flipX) || (item.value === 'flipY' && flipY) ? 'active' : ''}}" data-value="{{item.value}}" data-label="{{item.label}}" bindtap="applyRotate">
            <text class="edit-option-symbol">{{item.icon}}</text>
            <text>{{item.label}}</text>
          </button>
        </block>
        <block wx:elif="{{imageEditMode === 'correct'}}">
          <view class="correct-ruler" catchtouchstart="onCorrectionRulerStart" catchtouchmove="onCorrectionRulerMove">
            <view class="ruler-line">
              <text wx:for="{{correctTicks}}" wx:key="*this">{{item}}</text>
            </view>
            <view class="ruler-pointer" style="{{correctionPointerStyle}}"></view>
          </view>
          <button wx:for="{{correctOptions}}" wx:key="value" class="edit-option {{selectedCorrection === item.value ? 'active' : ''}}" data-value="{{item.value}}" data-label="{{item.label}}" bindtap="setCorrection">
            <text class="edit-option-symbol">{{item.icon}}</text>
            <text>{{item.label}}</text>
          </button>
        </block>
      </view>
      <view class="image-edit-tabs">
        <button wx:for="{{imageEditModes}}" wx:key="value" class="edit-tab {{imageEditMode === item.value ? 'active' : ''}}" data-value="{{item.value}}" bindtap="setImageEditMode">{{item.label}}</button>
      </view>
    </view>

    <view wx:if="{{tool === 'filter'}}" class="tool-panel">
      <text class="panel-label">滤镜风格</text>
      <view class="chip-row">
        <button wx:for="{{filterOptions}}" wx:key="value" class="chip {{selectedFilter === item.value ? 'active' : ''}}" data-value="{{item.value}}" bindtap="setFilter">{{item.label}}</button>
      </view>
    </view>

    <view wx:if="{{tool === 'pixel' && beadStage === 'crop'}}" class="tool-panel bead-crop-panel">
      <text class="panel-label">图纸尺寸</text>
      <view class="chip-row">
        <button wx:for="{{pixelOptions}}" wx:key="value" class="chip {{selectedPixel === item.value ? 'active' : ''}}" data-value="{{item.value}}" bindtap="setPixel">{{item.label}}格</button>
      </view>
      <view class="bead-size-row">
        <input type="number" value="{{beadGridWidth}}" data-axis="width" bindinput="onBeadGridInput" />
        <text>×</text>
        <input type="number" value="{{beadGridHeight}}" data-axis="height" bindinput="onBeadGridInput" />
        <text>格</text>
      </view>

      <text class="panel-label small">构图比例</text>
      <view class="chip-row">
        <button wx:for="{{beadRatioOptions}}" wx:key="value" class="chip {{beadCropRatio === item.value ? 'active' : ''}}" data-value="{{item.value}}" bindtap="setBeadCropRatio">{{item.label}}</button>
      </view>

      <text class="panel-label small">品牌色卡</text>
      <view class="chip-row">
        <button wx:for="{{beadBrandOptions}}" wx:key="value" class="chip {{beadBrand === item.value ? 'active' : ''}}" data-value="{{item.value}}" bindtap="setBeadBrand">{{item.label}}</button>
      </view>

      <text class="panel-label small">颜色数量</text>
      <view class="chip-row">
        <button wx:for="{{beadColorOptions}}" wx:key="*this" class="chip {{beadColorCount === item ? 'active' : ''}}" data-value="{{item}}" bindtap="setBeadColorCount">{{item}} 色</button>
      </view>
    </view>

    <view wx:if="{{tool === 'pixel' && beadStage === 'pattern'}}" class="tool-panel bead-pattern-panel">
      <view class="bead-pattern-actions">
        <button class="{{beadMirror ? 'active' : ''}}" data-key="mirror" bindtap="toggleBeadOption">镜像</button>
        <button class="{{beadShowGrid ? 'active' : ''}}" data-key="grid" bindtap="toggleBeadOption">▦ 网格</button>
        <button class="{{beadShowCodes ? 'active' : ''}}" data-key="codes" bindtap="toggleBeadOption"># 色号</button>
      </view>

      <view wx:if="{{beadPatternSummary}}" class="bead-summary">
        <text>{{beadPatternSummary}}</text>
      </view>

      <view wx:if="{{beadMaterials.length}}" class="bead-materials">
        <view class="bead-material-head">
          <text>材料清单</text>
          <text>{{beadMaterials.length}} 色</text>
        </view>
        <scroll-view scroll-x class="bead-material-list">
          <view wx:for="{{beadMaterials}}" wx:key="code" class="bead-material">
            <text class="bead-material-color" style="background: {{item.hex}};"></text>
            <text class="bead-material-name">{{item.code}}</text>
            <text class="bead-material-count">{{item.count}}</text>
          </view>
        </scroll-view>
      </view>
    </view>

    <view wx:if="{{tool === 'film'}}" class="tool-panel">
      <text class="panel-label">胶片色调</text>
      <view class="chip-row">
        <button wx:for="{{filmOptions}}" wx:key="value" class="chip {{selectedFilm === item.value ? 'active' : ''}}" data-value="{{item.value}}" bindtap="setFilm">{{item.label}}</button>
      </view>
    </view>

    <view wx:if="{{tool === 'watermark'}}" class="tool-panel">
      <text class="panel-label">水印文字</text>
      <input class="tool-input" value="{{watermarkText}}" placeholder="输入水印文字" bindinput="onWatermarkInput" />
      <text class="panel-label small">位置</text>
      <view class="chip-row">
        <button wx:for="{{watermarkPositions}}" wx:key="value" class="chip {{watermarkPosition === item.value ? 'active' : ''}}" data-value="{{item.value}}" bindtap="setWatermarkPosition">{{item.label}}</button>
      </view>
    </view>

    <view wx:if="{{tool === 'colorPick'}}" class="tool-panel">
      <text class="panel-label">提取色</text>
      <text wx:if="{{paletteStatus}}" class="palette-status">{{paletteStatus}}</text>
      <view class="swatch-row">
        <button wx:for="{{swatches}}" wx:key="*this" class="swatch {{selectedColor === item ? 'active' : ''}}" style="background: {{item}};" data-color="{{item}}" bindtap="selectSwatch"></button>
      </view>
      <button class="copy-row" data-value="{{selectedColor}}" bindtap="copyValue">{{selectedColor}} · 复制色值</button>
    </view>

    <view wx:if="{{tool === 'palette' || tool === 'gradient'}}" class="tool-panel">
      <text class="panel-label">{{tool === 'gradient' ? '渐变方案' : '色卡方案'}}</text>
      <text wx:if="{{paletteStatus}}" class="palette-status">{{paletteStatus}}</text>
      <view class="swatch-row">
        <button wx:for="{{swatches}}" wx:key="*this" class="swatch {{selectedColor === item ? 'active' : ''}}" style="background: {{item}};" data-color="{{item}}" bindtap="selectSwatch"></button>
      </view>
      <button class="copy-row" data-value="{{selectedColor}}" bindtap="copyValue">{{selectedColor}} · 复制选中色值</button>
      <view class="palette-row">
        <button wx:for="{{paletteSets}}" wx:key="label" class="palette-card {{selectedPalette === index ? 'active' : ''}}" data-index="{{index}}" bindtap="selectPalette">
          <view class="palette-preview">
            <text wx:for="{{item.colors}}" wx:key="*this" style="background: {{item}};"></text>
          </view>
          <text>{{item.label}}</text>
        </button>
      </view>
    </view>

    <view wx:if="{{tool === 'contrast'}}" class="tool-panel">
      <text class="panel-label">对比度检测</text>
      <input class="tool-input" value="{{contrastFg}}" data-key="fg" placeholder="#111111" bindinput="onContrastInput" />
      <input class="tool-input" value="{{contrastBg}}" data-key="bg" placeholder="#B7FF38" bindinput="onContrastInput" />
      <button class="copy-row" data-value="{{contrastScore}}" bindtap="copyValue">对比度 {{contrastScore}} · {{contrastLevel}}</button>
    </view>

    <view wx:if="{{tool === 'rgbhex'}}" class="tool-panel">
      <text class="panel-label">RGB 转 HEX</text>
      <view class="rgb-row">
        <input value="{{rgbR}}" type="number" data-channel="R" bindinput="onRgbInput" />
        <input value="{{rgbG}}" type="number" data-channel="G" bindinput="onRgbInput" />
        <input value="{{rgbB}}" type="number" data-channel="B" bindinput="onRgbInput" />
      </view>
      <input class="tool-input" value="{{hexValue}}" bindinput="onHexInput" />
      <button class="copy-row" data-value="{{hexValue}}" bindtap="copyValue">{{hexValue}} · 复制</button>
    </view>

    <view wx:if="{{tool === 'ai'}}" class="tool-panel">
      <text class="panel-label">AI 风格预设</text>
      <view class="chip-row">
        <button wx:for="{{aiOptions}}" wx:key="value" class="chip {{selectedAi === item.value ? 'active' : ''}}" data-value="{{item.value}}" bindtap="setAiPreset">{{item.label}}</button>
      </view>
    </view>

    <view wx:if="{{tool === 'more'}}" class="tool-panel">
      <text class="panel-label">所有工具</text>
      <view class="mini-tool-grid">
        <button wx:for="{{tools}}" wx:key="id" class="mini-tool" data-tool-id="{{item.id}}" bindtap="openToolFromList">
          <text>{{item.iconText}}</text>
          <text>{{item.name}}</text>
        </button>
      </view>
    </view>

    <view class="editor-actions">
      <button wx:if="{{tool === 'crop'}}" hover-class="button-press" hover-stay-time="80" bindtap="resetImageEdit">
        <text class="button-icon">×</text>
        <text>还原</text>
      </button>
      <button wx:else hover-class="button-press" hover-stay-time="80" bindtap="saveToAlbum">
        <text class="button-icon">↓</text>
        <text>{{tool === 'pixel' ? '导出图纸' : (needsImage ? '保存到相册' : '复制结果')}}</text>
      </button>
      <button class="primary" hover-class="button-press" hover-stay-time="80" bindtap="saveToDiary">
        <text class="button-icon">{{tool === 'crop' ? '✓' : '✦'}}</text>
        <text>{{tool === 'crop' ? '确认保存' : (tool === 'pixel' ? (beadStage === 'crop' ? '下一步' : '重新生成') : (tool === 'colorPick' || tool === 'palette' || tool === 'gradient' ? '保存到灵感' : '完成操作'))}}</text>
      </button>
    </view>
  </view>

  <canvas canvas-id="paletteCanvas" class="palette-canvas"></canvas>
  <canvas canvas-id="editCanvas" class="palette-canvas edit-canvas"></canvas>
</view>
