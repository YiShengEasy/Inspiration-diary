<view class="editor-page">
  <view class="editor-header">
    <button class="header-button icon-button" hover-class="button-press" hover-stay-time="80" bindtap="goBack">
      <text class="button-icon back-icon">‹</text>
      <text class="button-text">返回</text>
    </button>
    <view class="header-title">
      <text class="title">{{toolName}}</text>
      <text class="subtitle">{{toolDesc}}</text>
    </view>
    <button class="header-button icon-button" hover-class="button-press" hover-stay-time="80" bindtap="chooseImage">
      <text class="button-icon">↻</text>
      <text class="button-text">换图</text>
    </button>
  </view>

  <view class="editor-canvas {{tool === 'pixel' ? 'pixelated' : ''}}">
    <image wx:if="{{filePath}}" class="preview-image" src="{{resultPath || filePath}}" mode="aspectFit"></image>
    <view wx:else class="empty-preview" bindtap="chooseImage">
      <view class="empty-mark">
        <text>+</text>
      </view>
      <text class="empty-title">选择一张图片</text>
      <text class="empty-desc">从相册或相机导入后预览</text>
    </view>
    <view class="canvas-badge">
      <text class="tool-icon">{{toolIcon}}</text>
      <text>{{toolName}}</text>
    </view>
  </view>

  <view class="controls">
    <view class="control-head">
      <view>
        <text class="control-title">本地预览</text>
        <text class="control-desc">预览结果可保存到相册或灵感日记</text>
      </view>
      <button class="choose-button" hover-class="button-press" hover-stay-time="80" bindtap="chooseImage">
        <text class="button-icon">＋</text>
        <text>选择图片</text>
      </button>
    </view>

    <view class="result-row">
      <text class="result-label">当前工具</text>
      <text class="result-value">{{toolName}}</text>
    </view>
    <view class="result-row">
      <text class="result-label">图片状态</text>
      <text class="result-value">{{filePath ? '已选择' : '未选择'}}</text>
    </view>

    <view class="editor-actions">
      <button hover-class="button-press" hover-stay-time="80" bindtap="saveToAlbum">
        <text class="button-icon">↓</text>
        <text>保存到相册</text>
      </button>
      <button class="primary" hover-class="button-press" hover-stay-time="80" bindtap="saveToDiary">
        <text class="button-icon">✦</text>
        <text>保存到灵感日记</text>
      </button>
    </view>
  </view>
</view>
