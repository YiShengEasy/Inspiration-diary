.editor-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: #111111;
  color: #ffffff;
  animation: page-fade 180ms ease-out both;
}

button {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  gap: 8rpx;
  margin: 0;
  padding: 0;
  border: 0;
  line-height: normal;
  font-family: inherit;
  transition: transform 120ms ease, opacity 120ms ease, background 120ms ease;
}

button::after {
  border: 0;
}

.button-press {
  opacity: 0.82;
  transform: scale(0.96);
}

.editor-header {
  height: 116rpx;
  padding: 0 28rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  animation: slide-down 220ms ease-out both;
}

.header-button {
  flex: 0 0 88rpx;
  height: 72rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.1);
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 800;
}

.icon-button {
  flex-direction: column;
  gap: 2rpx;
}

.button-icon {
  display: block;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1;
}

.back-icon {
  font-size: 38rpx;
  line-height: 30rpx;
}

.button-text {
  display: block;
  font-size: 20rpx;
  line-height: 22rpx;
}

.header-title {
  min-width: 0;
  flex: 1;
  text-align: center;
}

.header-spacer {
  flex: 0 0 88rpx;
  height: 72rpx;
}

.title,
.subtitle {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.title {
  font-size: 32rpx;
  line-height: 38rpx;
  font-weight: 900;
}

.subtitle {
  margin-top: 6rpx;
  font-size: 22rpx;
  line-height: 28rpx;
  color: rgba(255, 255, 255, 0.55);
}

.editor-canvas {
  position: relative;
  flex: 1 1 auto;
  min-height: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  background: #1d1d1d;
  animation: canvas-rise 260ms ease-out both;
}

.preview-frame {
  position: relative;
  width: 86%;
  height: 560rpx;
  overflow: hidden;
  border-radius: 36rpx;
  box-shadow: 0 40rpx 120rpx rgba(0, 0, 0, 0.45);
  animation: preview-pop 240ms ease-out both;
  background: #2a2a2a;
}

.preview-frame.crop-square {
  width: 78%;
  height: 520rpx;
}

.preview-frame.crop-portrait {
  width: 72%;
  height: 620rpx;
}

.preview-frame.crop-wide {
  width: 88%;
  height: 360rpx;
}

.preview-image {
  display: block;
  width: 100%;
  height: 100%;
  background: #333333;
}

.effect-overlay {
  position: absolute;
  inset: 0;
  z-index: 1;
  pointer-events: none;
  opacity: 0.42;
}

.filter-soft,
.ai-soft {
  background: rgba(238, 232, 214, 0.46);
}

.filter-comic,
.ai-poster {
  background:
    linear-gradient(135deg, rgba(183, 255, 56, 0.22), rgba(255, 127, 111, 0.24)),
    repeating-linear-gradient(0deg, rgba(17, 17, 17, 0.12) 0 2rpx, transparent 2rpx 8rpx);
}

.filter-mono {
  background: rgba(0, 0, 0, 0.36);
}

.pixel-soft,
.pixel-medium,
.pixel-hard,
.ai-pixel {
  opacity: 0.34;
  background:
    repeating-linear-gradient(90deg, rgba(183, 255, 56, 0.24) 0 8rpx, transparent 8rpx 18rpx),
    repeating-linear-gradient(0deg, rgba(17, 17, 17, 0.20) 0 8rpx, transparent 8rpx 18rpx);
}

.pixel-hard {
  opacity: 0.5;
}

.film-warm {
  background: rgba(255, 182, 96, 0.28);
}

.film-cool {
  background: rgba(93, 180, 255, 0.22);
}

.film-fade {
  background: rgba(255, 247, 232, 0.34);
}

.crop-guides {
  position: absolute;
  inset: 0;
  z-index: 2;
  background:
    linear-gradient(90deg, transparent 33%, rgba(255, 255, 255, 0.42) 33% 33.5%, transparent 33.5% 66%, rgba(255, 255, 255, 0.42) 66% 66.5%, transparent 66.5%),
    linear-gradient(0deg, transparent 33%, rgba(255, 255, 255, 0.42) 33% 33.5%, transparent 33.5% 66%, rgba(255, 255, 255, 0.42) 66% 66.5%, transparent 66.5%);
  pointer-events: none;
}

.watermark-mark {
  position: absolute;
  z-index: 2;
  max-width: 70%;
  border-radius: 999rpx;
  padding: 12rpx 18rpx;
  background: rgba(0, 0, 0, 0.58);
  color: #ffffff;
  font-size: 23rpx;
  line-height: 28rpx;
  font-weight: 900;
}

.watermark-lt {
  left: 20rpx;
  top: 20rpx;
}

.watermark-rt {
  right: 20rpx;
  top: 20rpx;
}

.watermark-lb {
  left: 20rpx;
  bottom: 20rpx;
}

.watermark-rb {
  right: 20rpx;
  bottom: 20rpx;
}

.floating-palette {
  position: absolute;
  z-index: 2;
  left: 20rpx;
  right: 20rpx;
  bottom: 20rpx;
  display: flex;
  gap: 8rpx;
  padding: 10rpx;
  border-radius: 999rpx;
  background: rgba(17, 17, 17, 0.64);
}

.floating-palette text {
  flex: 1;
  height: 24rpx;
  border-radius: 999rpx;
}

.empty-preview {
  width: 520rpx;
  min-height: 420rpx;
  border-radius: 40rpx;
  box-sizing: border-box;
  border: 2rpx dashed rgba(255, 255, 255, 0.18);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.04);
  animation: preview-pop 260ms ease-out 80ms both;
}

.empty-mark,
.empty-title,
.empty-desc {
  display: block;
}

.utility-preview {
  width: 560rpx;
  min-height: 400rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: preview-pop 240ms ease-out both;
}

.color-result,
.contrast-result,
.more-preview {
  width: 100%;
  min-height: 330rpx;
  border-radius: 42rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 40rpx 120rpx rgba(0, 0, 0, 0.32);
}

.color-result text {
  border-radius: 999rpx;
  padding: 16rpx 26rpx;
  background: rgba(0, 0, 0, 0.64);
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 950;
}

.contrast-result {
  gap: 16rpx;
}

.contrast-demo {
  font-size: 46rpx;
  line-height: 56rpx;
  font-weight: 950;
}

.contrast-score {
  font-size: 24rpx;
  font-weight: 900;
}

.more-preview {
  gap: 18rpx;
  background: #222222;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 900;
}

.more-preview-icon {
  color: #b7ff38;
  font-size: 62rpx;
  line-height: 1;
}

.empty-mark {
  width: 96rpx;
  height: 96rpx;
  border-radius: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #b7ff38;
  color: #111111;
  font-size: 58rpx;
  font-weight: 300;
  animation: pulse-mark 1800ms ease-in-out infinite;
  box-shadow: 0 0 0 0 rgba(183, 255, 56, 0.36);
}

.empty-mark text {
  display: block;
  line-height: 1;
  transform: translateY(-3rpx);
}

.empty-title {
  margin-top: 28rpx;
  font-size: 32rpx;
  line-height: 38rpx;
  font-weight: 900;
}

.empty-desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 32rpx;
  color: rgba(255, 255, 255, 0.52);
}

.canvas-badge {
  position: absolute;
  left: 32rpx;
  top: 32rpx;
  height: 64rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  background: rgba(0, 0, 0, 0.58);
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 900;
  animation: badge-in 240ms ease-out 90ms both;
}

.tool-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 28rpx;
  height: 28rpx;
  color: #b7ff38;
  font-size: 24rpx;
  line-height: 1;
}

.controls {
  flex: 0 0 auto;
  max-height: 34vh;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
  padding: 28rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
  border-radius: 38rpx 38rpx 0 0;
  box-sizing: border-box;
  background: #ffffff;
  color: #111111;
  animation: sheet-up 260ms ease-out both;
}

.control-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.control-title,
.control-desc {
  display: block;
}

.control-title {
  font-size: 29rpx;
  line-height: 34rpx;
  font-weight: 900;
}

.control-desc {
  width: 390rpx;
  margin-top: 4rpx;
  font-size: 20rpx;
  line-height: 26rpx;
  color: #7c8078;
}

.choose-button {
  flex: 0 0 142rpx;
  height: 60rpx;
  border-radius: 999rpx;
  background: #111111;
  color: #b7ff38;
  font-size: 22rpx;
  font-weight: 900;
}

.tool-panel {
  margin-top: 16rpx;
  border-radius: 22rpx;
  padding: 18rpx;
  background: #f7f7f2;
}

.panel-label {
  display: block;
  margin-bottom: 12rpx;
  color: #111111;
  font-size: 22rpx;
  line-height: 28rpx;
  font-weight: 950;
}

.panel-label.small {
  margin-top: 14rpx;
  margin-bottom: 10rpx;
  color: #7c8078;
  font-size: 19rpx;
}

.chip-row,
.swatch-row,
.palette-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.chip {
  min-width: 98rpx;
  height: 50rpx;
  border-radius: 999rpx;
  padding: 0 18rpx;
  background: #ffffff;
  color: #111111;
  font-size: 21rpx;
  font-weight: 900;
}

.chip.active {
  background: #111111;
  color: #b7ff38;
}

.tool-input {
  width: 100%;
  height: 60rpx;
  box-sizing: border-box;
  border-radius: 18rpx;
  padding: 0 18rpx;
  background: #ffffff;
  color: #111111;
  font-size: 22rpx;
  font-weight: 850;
}

.swatch {
  width: 56rpx;
  height: 56rpx;
  border-radius: 20rpx;
  border: 4rpx solid #ffffff;
  box-shadow: inset 0 0 0 2rpx rgba(17, 17, 17, 0.08);
}

.palette-status {
  display: block;
  margin: -6rpx 0 12rpx;
  color: #7c8078;
  font-size: 19rpx;
  line-height: 24rpx;
  font-weight: 800;
}

.swatch.active {
  box-shadow: 0 0 0 5rpx #111111;
}

.copy-row {
  width: 100%;
  height: 54rpx;
  margin-top: 12rpx;
  border-radius: 18rpx;
  background: #111111;
  color: #b7ff38;
  font-size: 21rpx;
  font-weight: 950;
}

.palette-card {
  flex: 1 1 180rpx;
  min-height: 90rpx;
  border-radius: 20rpx;
  padding: 12rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 9rpx;
  align-items: stretch;
  background: #ffffff;
  color: #111111;
  font-size: 20rpx;
  font-weight: 950;
}

.palette-card.active {
  box-shadow: 0 0 0 4rpx #111111;
}

.palette-preview {
  display: flex;
  overflow: hidden;
  height: 28rpx;
  border-radius: 999rpx;
}

.palette-preview text {
  flex: 1;
}

.rgb-row {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10rpx;
  margin-bottom: 12rpx;
}

.rgb-row input {
  height: 60rpx;
  border-radius: 18rpx;
  padding: 0 14rpx;
  box-sizing: border-box;
  background: #ffffff;
  color: #111111;
  font-size: 22rpx;
  font-weight: 900;
  text-align: center;
}

.mini-tool-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10rpx;
}

.mini-tool {
  min-height: 68rpx;
  border-radius: 18rpx;
  display: grid;
  grid-template-columns: 36rpx 1fr;
  justify-content: flex-start;
  padding: 0 16rpx;
  background: #ffffff;
  color: #111111;
  font-size: 20rpx;
  font-weight: 900;
}

.editor-actions {
  display: flex;
  gap: 14rpx;
  margin-top: 18rpx;
}

.editor-actions button {
  flex: 1;
  height: 70rpx;
  border-radius: 999rpx;
  background: #f2f2ed;
  color: #111111;
  font-size: 23rpx;
  font-weight: 900;
}

.editor-actions .primary {
  background: #b7ff38;
}

.palette-canvas {
  position: fixed;
  left: -200rpx;
  top: -200rpx;
  width: 80px;
  height: 80px;
  pointer-events: none;
  opacity: 0;
}

@keyframes page-fade {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes slide-down {
  from {
    opacity: 0;
    transform: translateY(-18rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes canvas-rise {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes preview-pop {
  from {
    opacity: 0;
    transform: scale(0.96);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

@keyframes badge-in {
  from {
    opacity: 0;
    transform: translateX(-18rpx);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}

@keyframes sheet-up {
  from {
    transform: translateY(34rpx);
  }
  to {
    transform: translateY(0);
  }
}

@keyframes row-in {
  from {
    opacity: 0;
    transform: translateY(10rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes pulse-mark {
  0%,
  100% {
    transform: scale(1);
    box-shadow: 0 0 0 0 rgba(183, 255, 56, 0.32);
  }
  50% {
    transform: scale(1.04);
    box-shadow: 0 0 0 18rpx rgba(183, 255, 56, 0);
  }
}
