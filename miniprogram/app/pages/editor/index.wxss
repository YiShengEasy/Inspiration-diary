.editor-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: #111111;
  color: #ffffff;
  animation: page-fade 180ms ease-out both;
}

button {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  gap: 8rpx;
  margin: 0;
  padding: 0;
  border: 0;
  line-height: normal;
  font-family: inherit;
  transition: transform 120ms ease, opacity 120ms ease, background 120ms ease;
}

button::after {
  border: 0;
}

.button-press {
  opacity: 0.82;
  transform: scale(0.96);
}

.editor-header {
  height: 116rpx;
  padding: 0 28rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  animation: slide-down 220ms ease-out both;
}

.header-button {
  flex: 0 0 88rpx;
  height: 72rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.1);
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 800;
}

.next-button {
  flex-basis: 140rpx;
  border: 0;
  border-radius: 999rpx;
  background: #b7ff38;
  color: #132006;
  font-size: 26rpx;
  font-weight: 950;
  box-shadow: 0 10rpx 28rpx rgba(183, 255, 56, 0.16);
}

.icon-button {
  flex-direction: column;
  gap: 2rpx;
}

.button-icon {
  display: block;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1;
}

.back-icon {
  font-size: 38rpx;
  line-height: 30rpx;
}

.button-text {
  display: block;
  font-size: 20rpx;
  line-height: 22rpx;
}

.header-title {
  min-width: 0;
  flex: 1;
  text-align: center;
}

.header-spacer {
  flex: 0 0 88rpx;
  height: 72rpx;
}

.title,
.subtitle {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.title {
  font-size: 32rpx;
  line-height: 38rpx;
  font-weight: 900;
}

.subtitle {
  margin-top: 6rpx;
  font-size: 22rpx;
  line-height: 28rpx;
  color: rgba(255, 255, 255, 0.55);
}

.editor-canvas {
  position: relative;
  flex: 1 1 auto;
  min-height: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  background: #1d1d1d;
  animation: canvas-rise 260ms ease-out both;
}

.preview-frame {
  position: relative;
  width: 86%;
  height: 560rpx;
  overflow: hidden;
  border-radius: 36rpx;
  box-shadow: 0 40rpx 120rpx rgba(0, 0, 0, 0.45);
  animation: preview-pop 240ms ease-out both;
  background: #2a2a2a;
}

.preview-frame.image-editor-frame {
  border-radius: 0;
  border: 5rpx solid rgba(255, 255, 255, 0.92);
  box-shadow: 0 0 0 999rpx rgba(0, 0, 0, 0.36);
  background: #252525;
}

.preview-frame.crop-free,
.preview-frame.crop-original,
.preview-frame.expand-original {
  width: 86%;
  height: 560rpx;
}

.preview-frame.crop-square {
  width: 78%;
  height: 520rpx;
}

.preview-frame.crop-portrait23,
.preview-frame.expand-portrait34,
.preview-frame.expand-story {
  width: 70%;
  height: 640rpx;
}

.preview-frame.crop-landscape32,
.preview-frame.crop-landscape43,
.preview-frame.crop-wide,
.preview-frame.expand-landscape43,
.preview-frame.expand-wide {
  width: 88%;
  height: 360rpx;
}

.preview-frame.crop-portrait34 {
  width: 72%;
  height: 620rpx;
}

.preview-frame.expand-square {
  width: 78%;
  height: 520rpx;
}

.preview-frame.pixel-crop-frame {
  border: 4rpx solid rgba(255, 255, 255, 0.92);
  border-radius: 0;
  box-shadow: 0 0 0 999rpx rgba(0, 0, 0, 0.5);
}

.preview-frame.bead-pattern-frame {
  width: 94%;
  height: 100%;
  max-height: 960rpx;
  border-radius: 18rpx;
  background: #f7f7f2;
  box-shadow: none;
}

.preview-frame.bead-pattern-frame .preview-image {
  background: #f7f7f2;
}

.preview-frame.expand-story {
  width: 58%;
  height: 660rpx;
}

.preview-frame.expand-wide {
  height: 330rpx;
}

.preview-image {
  display: block;
  width: 100%;
  height: 100%;
  background: #333333;
  transition: transform 180ms ease, filter 180ms ease;
  transform-origin: center;
}

.preview-image.rotate-1 {
  transform: rotate(90deg) scale(1.02);
}

.preview-image.rotate-2 {
  transform: rotate(180deg) scale(1.02);
}

.preview-image.rotate-3 {
  transform: rotate(270deg) scale(1.02);
}

.preview-image.flip-x {
  transform: scaleX(-1);
}

.preview-image.flip-y {
  transform: scaleY(-1);
}

.preview-image.rotate-1.flip-x {
  transform: rotate(90deg) scaleX(-1);
}

.preview-image.rotate-1.flip-y {
  transform: rotate(90deg) scaleY(-1);
}

.preview-image.rotate-2.flip-x {
  transform: rotate(180deg) scaleX(-1);
}

.preview-image.rotate-2.flip-y {
  transform: rotate(180deg) scaleY(-1);
}

.preview-image.rotate-3.flip-x {
  transform: rotate(270deg) scaleX(-1);
}

.preview-image.rotate-3.flip-y {
  transform: rotate(270deg) scaleY(-1);
}

.preview-image.correct-perspective {
  transform: perspective(720rpx) rotateX(5deg) rotateY(-5deg) scale(1.02);
}

.preview-image.correct-vertical {
  transform: skewY(-4deg) scale(1.03);
}

.preview-image.correct-horizontal {
  transform: skewX(4deg) scale(1.03);
}

.effect-overlay {
  position: absolute;
  inset: 0;
  z-index: 1;
  pointer-events: none;
  opacity: 0.42;
}

.filter-soft,
.ai-soft {
  background: rgba(238, 232, 214, 0.46);
}

.filter-comic,
.ai-poster {
  background:
    linear-gradient(135deg, rgba(183, 255, 56, 0.22), rgba(255, 127, 111, 0.24)),
    repeating-linear-gradient(0deg, rgba(17, 17, 17, 0.12) 0 2rpx, transparent 2rpx 8rpx);
}

.filter-mono {
  background: rgba(0, 0, 0, 0.36);
}

.pixel-soft,
.pixel-medium,
.pixel-hard,
.ai-pixel {
  opacity: 0.34;
  background:
    repeating-linear-gradient(90deg, rgba(183, 255, 56, 0.24) 0 8rpx, transparent 8rpx 18rpx),
    repeating-linear-gradient(0deg, rgba(17, 17, 17, 0.20) 0 8rpx, transparent 8rpx 18rpx);
}

.pixel-hard {
  opacity: 0.5;
}

.film-warm {
  background: rgba(255, 182, 96, 0.28);
}

.film-cool {
  background: rgba(93, 180, 255, 0.22);
}

.film-fade {
  background: rgba(255, 247, 232, 0.34);
}

.crop-guides {
  position: absolute;
  inset: 0;
  z-index: 2;
  background:
    linear-gradient(90deg, transparent 33%, rgba(255, 255, 255, 0.42) 33% 33.5%, transparent 33.5% 66%, rgba(255, 255, 255, 0.42) 66% 66.5%, transparent 66.5%),
    linear-gradient(0deg, transparent 33%, rgba(255, 255, 255, 0.42) 33% 33.5%, transparent 33.5% 66%, rgba(255, 255, 255, 0.42) 66% 66.5%, transparent 66.5%);
  pointer-events: none;
}

.edit-border {
  position: absolute;
  inset: 0;
  z-index: 3;
  pointer-events: none;
}

.bead-left-toolbar {
  position: absolute;
  left: 22rpx;
  top: 36rpx;
  z-index: 5;
  width: 92rpx;
  border: 2rpx solid rgba(17, 17, 17, 0.1);
  border-radius: 999rpx;
  padding: 16rpx 0;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  background: rgba(247, 247, 242, 0.92);
  box-shadow: 0 18rpx 50rpx rgba(17, 17, 17, 0.18);
}

.bead-left-toolbar button {
  width: 58rpx;
  height: 58rpx;
  border-radius: 999rpx;
  background: transparent;
  color: #777b72;
  font-size: 28rpx;
  font-weight: 950;
}

.bead-left-toolbar button.active {
  background: #111111;
  color: #b7ff38;
}

.bead-left-toolbar button.disabled {
  opacity: 0.45;
}

.bead-left-toolbar text {
  width: 58rpx;
  height: 58rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 14rpx;
  background: #111111;
  color: #b7ff38;
  font-size: 22rpx;
  font-weight: 950;
}

.bead-generating {
  position: absolute;
  inset: 0;
  z-index: 4;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(17, 17, 17, 0.36);
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 950;
}

.edit-border::before,
.edit-border::after {
  content: "";
  position: absolute;
  background: rgba(255, 255, 255, 0.95);
}

.edit-border::before {
  left: 50%;
  top: -7rpx;
  width: 74rpx;
  height: 12rpx;
  margin-left: -37rpx;
}

.edit-border::after {
  left: 50%;
  bottom: -7rpx;
  width: 74rpx;
  height: 12rpx;
  margin-left: -37rpx;
}

.handle {
  position: absolute;
  background: rgba(255, 255, 255, 0.95);
}

.handle.top,
.handle.bottom {
  left: 10%;
  right: 10%;
  height: 4rpx;
}

.handle.top {
  top: -4rpx;
}

.handle.bottom {
  bottom: -4rpx;
}

.handle.left,
.handle.right {
  top: 16%;
  bottom: 16%;
  width: 4rpx;
}

.handle.left {
  left: -4rpx;
}

.handle.right {
  right: -4rpx;
}

.restore-badge {
  position: absolute;
  left: 50%;
  bottom: 40rpx;
  z-index: 4;
  max-width: 68%;
  transform: translateX(-50%);
  border-radius: 10rpx;
  padding: 10rpx 18rpx;
  background: rgba(0, 0, 0, 0.58);
  color: rgba(255, 255, 255, 0.92);
  font-size: 24rpx;
  line-height: 30rpx;
  font-weight: 850;
}

.watermark-mark {
  position: absolute;
  z-index: 2;
  max-width: 70%;
  border-radius: 999rpx;
  padding: 12rpx 18rpx;
  background: rgba(0, 0, 0, 0.58);
  color: #ffffff;
  font-size: 23rpx;
  line-height: 28rpx;
  font-weight: 900;
}

.watermark-lt {
  left: 20rpx;
  top: 20rpx;
}

.watermark-rt {
  right: 20rpx;
  top: 20rpx;
}

.watermark-lb {
  left: 20rpx;
  bottom: 20rpx;
}

.watermark-rb {
  right: 20rpx;
  bottom: 20rpx;
}

.floating-palette {
  position: absolute;
  z-index: 2;
  left: 20rpx;
  right: 20rpx;
  bottom: 20rpx;
  display: flex;
  gap: 8rpx;
  padding: 10rpx;
  border-radius: 999rpx;
  background: rgba(17, 17, 17, 0.64);
}

.floating-palette text {
  flex: 1;
  height: 24rpx;
  border-radius: 999rpx;
}

.empty-preview {
  width: 520rpx;
  min-height: 420rpx;
  border-radius: 40rpx;
  box-sizing: border-box;
  border: 2rpx dashed rgba(255, 255, 255, 0.18);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.04);
  animation: preview-pop 260ms ease-out 80ms both;
}

.empty-mark,
.empty-title,
.empty-desc {
  display: block;
}

.utility-preview {
  width: 560rpx;
  min-height: 400rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: preview-pop 240ms ease-out both;
}

.color-result,
.contrast-result,
.more-preview {
  width: 100%;
  min-height: 330rpx;
  border-radius: 42rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 40rpx 120rpx rgba(0, 0, 0, 0.32);
}

.color-result text {
  border-radius: 999rpx;
  padding: 16rpx 26rpx;
  background: rgba(0, 0, 0, 0.64);
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 950;
}

.contrast-result {
  gap: 16rpx;
}

.contrast-demo {
  font-size: 46rpx;
  line-height: 56rpx;
  font-weight: 950;
}

.contrast-score {
  font-size: 24rpx;
  font-weight: 900;
}

.more-preview {
  gap: 18rpx;
  background: #222222;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 900;
}

.more-preview-icon {
  color: #b7ff38;
  font-size: 62rpx;
  line-height: 1;
}

.empty-mark {
  width: 96rpx;
  height: 96rpx;
  border-radius: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #b7ff38;
  color: #111111;
  font-size: 58rpx;
  font-weight: 300;
  animation: pulse-mark 1800ms ease-in-out infinite;
  box-shadow: 0 0 0 0 rgba(183, 255, 56, 0.36);
}

.empty-mark text {
  display: block;
  line-height: 1;
  transform: translateY(-3rpx);
}

.empty-title {
  margin-top: 28rpx;
  font-size: 32rpx;
  line-height: 38rpx;
  font-weight: 900;
}

.empty-desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 32rpx;
  color: rgba(255, 255, 255, 0.52);
}

.canvas-badge {
  position: absolute;
  left: 32rpx;
  top: 32rpx;
  height: 64rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  background: rgba(0, 0, 0, 0.58);
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 900;
  animation: badge-in 240ms ease-out 90ms both;
}

.tool-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 28rpx;
  height: 28rpx;
  color: #b7ff38;
  font-size: 24rpx;
  line-height: 1;
}

.controls {
  flex: 0 0 auto;
  max-height: 34vh;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
  padding: 28rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
  border-radius: 38rpx 38rpx 0 0;
  box-sizing: border-box;
  background: #ffffff;
  color: #111111;
  animation: sheet-up 260ms ease-out both;
}

.controls.image-edit-sheet {
  max-height: 34vh;
  padding-top: 22rpx;
  background: #030303;
  color: #ffffff;
  border-radius: 0;
}

.controls.bead-crop-sheet {
  max-height: 38vh;
  border-radius: 0;
}

.controls.bead-result-sheet {
  max-height: 36vh;
  border-radius: 0;
  background: #ffffff;
}

.image-edit-sheet .control-head {
  display: none;
}

.image-edit-sheet .tool-panel {
  margin-top: 0;
  padding: 0;
  border-radius: 0;
  background: transparent;
}

.control-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.control-title,
.control-desc {
  display: block;
}

.control-title {
  font-size: 29rpx;
  line-height: 34rpx;
  font-weight: 900;
}

.control-desc {
  width: 390rpx;
  margin-top: 4rpx;
  font-size: 20rpx;
  line-height: 26rpx;
  color: #7c8078;
}

.choose-button {
  flex: 0 0 142rpx;
  height: 60rpx;
  border-radius: 999rpx;
  background: #111111;
  color: #b7ff38;
  font-size: 22rpx;
  font-weight: 900;
}

.tool-panel {
  margin-top: 16rpx;
  border-radius: 22rpx;
  padding: 18rpx;
  background: #f7f7f2;
}

.bead-crop-panel {
  background: #ffffff;
}

.bead-crop-panel .chip {
  min-width: 116rpx;
  height: 60rpx;
  border: 0;
  border-radius: 999rpx;
  background: #f2f2ed;
  color: #7c8078;
  font-size: 22rpx;
}

.bead-crop-panel .chip.active {
  background: #111111;
  color: #b7ff38;
  box-shadow: none;
}

.bead-pattern-panel {
  margin-top: 8rpx;
  padding: 0;
  background: transparent;
}

.bead-pattern-actions {
  display: flex;
  justify-content: flex-end;
  gap: 10rpx;
}

.bead-pattern-actions button {
  height: 58rpx;
  border: 4rpx solid #dedbd1;
  border-radius: 18rpx;
  padding: 0 20rpx;
  background: #ffffff;
  color: #777b72;
  font-size: 22rpx;
  font-weight: 950;
}

.bead-pattern-actions button.active {
  border-color: #111111;
  background: #111111;
  color: #b7ff38;
}

.image-edit-options {
  min-height: 132rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 22rpx;
  flex-wrap: wrap;
  overflow-x: auto;
  padding: 2rpx 6rpx 12rpx;
  box-sizing: border-box;
  -webkit-overflow-scrolling: touch;
}

.rotate-wheel,
.correct-ruler {
  flex: 0 0 100%;
  position: relative;
  height: 170rpx;
  margin-bottom: 2rpx;
}

.wheel-window {
  position: absolute;
  left: 50%;
  top: 0;
  width: 520rpx;
  height: 128rpx;
  transform: translateX(-50%);
  overflow: hidden;
}

.wheel-arc {
  position: absolute;
  left: 50%;
  top: -384rpx;
  width: 520rpx;
  height: 520rpx;
  box-sizing: border-box;
  transform: translateX(-50%);
  border: 4rpx solid rgba(255, 255, 255, 0.38);
  border-radius: 50%;
  transition: transform 80ms linear;
  will-change: transform;
}

.wheel-arc::before {
  content: "";
  position: absolute;
  left: 42rpx;
  right: 42rpx;
  bottom: 26rpx;
  height: 4rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.28);
}

.wheel-arc::after {
  content: "";
  position: absolute;
  left: 50%;
  bottom: -12rpx;
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #b7ff38;
  transform: translateX(-50%);
  box-shadow: 0 0 22rpx rgba(183, 255, 56, 0.45);
}

.wheel-mark {
  position: absolute;
  left: 50%;
  top: 50%;
  z-index: 1;
  width: 3rpx;
  height: 24rpx;
  margin-left: -1.5rpx;
  transform-origin: 50% 0;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.64);
}

.wheel-mark.major {
  width: 4rpx;
  height: 36rpx;
  margin-left: -2rpx;
  background: rgba(255, 255, 255, 0.92);
}

.wheel-mark text {
  position: absolute;
  left: 50%;
  top: 46rpx;
  width: 68rpx;
  margin-left: -34rpx;
  text-align: center;
  color: rgba(255, 255, 255, 0.72);
  font-size: 20rpx;
  line-height: 24rpx;
  font-weight: 800;
  transform-origin: 50% 50%;
}

.wheel-pointer {
  position: absolute;
  left: 50%;
  top: 104rpx;
  width: 0;
  height: 0;
  border-left: 12rpx solid transparent;
  border-right: 12rpx solid transparent;
  border-bottom: 20rpx solid #b7ff38;
  transform: translateX(-50%);
}

.wheel-angle {
  position: absolute;
  left: 50%;
  top: 130rpx;
  transform: translateX(-50%);
  min-width: 86rpx;
  border-radius: 999rpx;
  padding: 7rpx 18rpx;
  background: rgba(255, 255, 255, 0.1);
  text-align: center;
  color: #ffffff;
  font-size: 24rpx;
  line-height: 28rpx;
  font-weight: 900;
}

.correct-ruler {
  height: 118rpx;
  padding: 0 4rpx;
  box-sizing: border-box;
}

.ruler-line {
  position: absolute;
  left: 8rpx;
  right: 8rpx;
  top: 30rpx;
  height: 56rpx;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
}

.ruler-line::before {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  height: 38rpx;
  background: repeating-linear-gradient(90deg, rgba(255, 255, 255, 0.72) 0 3rpx, transparent 3rpx 19rpx);
}

.ruler-line text {
  position: relative;
  z-index: 1;
  color: rgba(255, 255, 255, 0.54);
  font-size: 21rpx;
  line-height: 24rpx;
  font-weight: 750;
}

.ruler-pointer {
  position: absolute;
  left: 50%;
  top: 18rpx;
  width: 3rpx;
  height: 72rpx;
  background: #ffffff;
  transform: translateX(-50%);
}

.ruler-pointer::before {
  content: "";
  position: absolute;
  left: 50%;
  top: -16rpx;
  width: 0;
  height: 0;
  border-left: 12rpx solid transparent;
  border-right: 12rpx solid transparent;
  border-top: 20rpx solid #ffffff;
  transform: translateX(-50%);
}

.edit-option {
  flex: 0 0 118rpx;
  min-height: 118rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  color: rgba(255, 255, 255, 0.88);
  background: transparent;
  font-size: 22rpx;
  line-height: 28rpx;
  font-weight: 800;
}

.edit-option.active {
  color: #b7ff38;
}

.edit-option-icon {
  width: 46rpx;
  height: 46rpx;
  box-sizing: border-box;
  border: 4rpx solid currentColor;
}

.icon-crop-free {
  border-radius: 18rpx;
  border-style: dashed;
}

.icon-crop-original,
.icon-expand-original {
  width: 50rpx;
  height: 42rpx;
}

.icon-crop-square,
.icon-expand-square {
  width: 46rpx;
  height: 46rpx;
}

.icon-crop-portrait23,
.icon-expand-portrait34,
.icon-expand-story {
  width: 36rpx;
  height: 52rpx;
}

.icon-crop-landscape32,
.icon-expand-landscape43,
.icon-expand-wide {
  width: 58rpx;
  height: 34rpx;
}

.edit-option-symbol {
  font-size: 54rpx;
  line-height: 54rpx;
  font-weight: 400;
}

.image-edit-tabs {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 8rpx;
  margin-top: 10rpx;
}

.edit-tab {
  position: relative;
  height: 74rpx;
  background: transparent;
  color: rgba(255, 255, 255, 0.36);
  font-size: 27rpx;
  font-weight: 900;
}

.edit-tab.active {
  color: #b7ff38;
}

.edit-tab.active::after {
  content: "";
  position: absolute;
  left: 50%;
  bottom: 0;
  width: 58rpx;
  height: 6rpx;
  border-radius: 999rpx;
  background: #b7ff38;
  transform: translateX(-50%);
}

.panel-label {
  display: block;
  margin-bottom: 12rpx;
  color: #111111;
  font-size: 22rpx;
  line-height: 28rpx;
  font-weight: 950;
}

.panel-label.small {
  margin-top: 14rpx;
  margin-bottom: 10rpx;
  color: #7c8078;
  font-size: 19rpx;
}

.chip-row,
.swatch-row,
.palette-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.chip {
  min-width: 98rpx;
  height: 50rpx;
  border-radius: 999rpx;
  padding: 0 18rpx;
  background: #ffffff;
  color: #111111;
  font-size: 21rpx;
  font-weight: 900;
}

.chip.active {
  background: #111111;
  color: #b7ff38;
}

.bead-size-row {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 24rpx minmax(0, 1fr) 36rpx;
  gap: 10rpx;
  align-items: center;
  margin-top: 12rpx;
  color: #7c8078;
  font-size: 22rpx;
  font-weight: 900;
}

.bead-size-row input {
  height: 58rpx;
  border-radius: 18rpx;
  padding: 0 14rpx;
  box-sizing: border-box;
  background: #ffffff;
  color: #111111;
  font-size: 23rpx;
  font-weight: 950;
  text-align: center;
}

.bead-summary {
  margin-top: 14rpx;
  border-radius: 18rpx;
  padding: 12rpx 16rpx;
  background: #111111;
  color: #b7ff38;
  font-size: 21rpx;
  font-weight: 950;
}

.bead-materials {
  margin-top: 14rpx;
  padding: 0;
  background: transparent;
}

.bead-material-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
  color: #111111;
  font-size: 22rpx;
  font-weight: 950;
}

.bead-material-list {
  width: 100%;
  height: 96rpx;
  white-space: nowrap;
}

.bead-material {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 96rpx;
  height: 86rpx;
  margin-right: 12rpx;
  border-radius: 18rpx;
  background: #ffffff;
  color: #111111;
  vertical-align: top;
  box-shadow: 0 4rpx 14rpx rgba(17, 17, 17, 0.08);
}

.bead-material-color {
  width: 28rpx;
  height: 20rpx;
  border-radius: 999rpx;
  border: 2rpx solid rgba(17, 17, 17, 0.1);
  box-sizing: border-box;
  box-shadow: none;
}

.bead-material-name,
.bead-material-count {
  display: block;
}

.bead-material-name {
  color: #111111;
  font-size: 23rpx;
  line-height: 27rpx;
  font-weight: 950;
}

.bead-material-count {
  margin-top: 1rpx;
  color: #111111;
  font-size: 21rpx;
  line-height: 25rpx;
  font-weight: 950;
}

.tool-input {
  width: 100%;
  height: 60rpx;
  box-sizing: border-box;
  border-radius: 18rpx;
  padding: 0 18rpx;
  background: #ffffff;
  color: #111111;
  font-size: 22rpx;
  font-weight: 850;
}

.swatch {
  width: 56rpx;
  height: 56rpx;
  border-radius: 20rpx;
  border: 4rpx solid #ffffff;
  box-shadow: inset 0 0 0 2rpx rgba(17, 17, 17, 0.08);
}

.palette-status {
  display: block;
  margin: -6rpx 0 12rpx;
  color: #7c8078;
  font-size: 19rpx;
  line-height: 24rpx;
  font-weight: 800;
}

.swatch.active {
  box-shadow: 0 0 0 5rpx #111111;
}

.copy-row {
  width: 100%;
  height: 54rpx;
  margin-top: 12rpx;
  border-radius: 18rpx;
  background: #111111;
  color: #b7ff38;
  font-size: 21rpx;
  font-weight: 950;
}

.palette-card {
  flex: 1 1 180rpx;
  min-height: 90rpx;
  border-radius: 20rpx;
  padding: 12rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 9rpx;
  align-items: stretch;
  background: #ffffff;
  color: #111111;
  font-size: 20rpx;
  font-weight: 950;
}

.palette-card.active {
  box-shadow: 0 0 0 4rpx #111111;
}

.palette-preview {
  display: flex;
  overflow: hidden;
  height: 28rpx;
  border-radius: 999rpx;
}

.palette-preview text {
  flex: 1;
}

.rgb-row {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10rpx;
  margin-bottom: 12rpx;
}

.rgb-row input {
  height: 60rpx;
  border-radius: 18rpx;
  padding: 0 14rpx;
  box-sizing: border-box;
  background: #ffffff;
  color: #111111;
  font-size: 22rpx;
  font-weight: 900;
  text-align: center;
}

.mini-tool-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10rpx;
}

.mini-tool {
  min-height: 68rpx;
  border-radius: 18rpx;
  display: grid;
  grid-template-columns: 36rpx 1fr;
  justify-content: flex-start;
  padding: 0 16rpx;
  background: #ffffff;
  color: #111111;
  font-size: 20rpx;
  font-weight: 900;
}

.editor-actions {
  display: flex;
  gap: 14rpx;
  margin-top: 18rpx;
}

.editor-actions button {
  flex: 1;
  height: 70rpx;
  border-radius: 999rpx;
  background: #f2f2ed;
  color: #111111;
  font-size: 23rpx;
  font-weight: 900;
}

.image-edit-sheet .editor-actions {
  align-items: center;
  margin-top: 12rpx;
}

.image-edit-sheet .editor-actions button {
  height: 76rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.08);
  color: #ffffff;
  font-size: 26rpx;
}

.image-edit-sheet .editor-actions .primary {
  background: transparent;
  color: #ffffff;
}

.editor-actions .primary {
  background: #b7ff38;
}

.palette-canvas {
  position: fixed;
  left: -200rpx;
  top: -200rpx;
  width: 80px;
  height: 80px;
  pointer-events: none;
  opacity: 0;
}

.edit-canvas {
  left: -1200px;
  top: -1200px;
  width: 960px;
  height: 960px;
}

@keyframes page-fade {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes slide-down {
  from {
    opacity: 0;
    transform: translateY(-18rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes canvas-rise {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes preview-pop {
  from {
    opacity: 0;
    transform: scale(0.96);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

@keyframes badge-in {
  from {
    opacity: 0;
    transform: translateX(-18rpx);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}

@keyframes sheet-up {
  from {
    transform: translateY(34rpx);
  }
  to {
    transform: translateY(0);
  }
}

@keyframes row-in {
  from {
    opacity: 0;
    transform: translateY(10rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes pulse-mark {
  0%,
  100% {
    transform: scale(1);
    box-shadow: 0 0 0 0 rgba(183, 255, 56, 0.32);
  }
  50% {
    transform: scale(1.04);
    box-shadow: 0 0 0 18rpx rgba(183, 255, 56, 0);
  }
}
