.grid-page { min-height:100vh; padding:28rpx 31rpx 120rpx; box-sizing:border-box; background:#fff; color:#151712; }
button { margin:0; padding:0; border:0; line-height:1; }
button::after { border:0; }
.hero-card { position:relative; overflow:hidden; min-height:210rpx; padding:34rpx; box-sizing:border-box; border-radius:34rpx; background:linear-gradient(118deg,#e9edff,#ded4ff 52%,#d9f8ec); }
.hero-card::after { content:""; position:absolute; right:-25rpx; top:-70rpx; width:240rpx; height:230rpx; border-radius:76rpx; background:rgba(183,255,56,.38); transform:rotate(13deg); }
.hero-kicker,.hero-title,.hero-desc { position:relative; z-index:1; display:block; }
.hero-kicker { color:#5742c8; font-size:20rpx; line-height:24rpx; font-weight:900; }
.hero-title { margin-top:12rpx; font-size:49rpx; line-height:55rpx; font-weight:950; }
.hero-desc { width:460rpx; margin-top:13rpx; color:rgba(28,27,62,.62); font-size:21rpx; line-height:29rpx; }
.choose-button { display:flex; align-items:center; justify-content:center; width:100%; min-height:96rpx; margin-top:28rpx; border:3rpx dashed #cfd3c8; border-radius:28rpx; background:#fafbf7; color:#1c1e19; font-size:24rpx; font-weight:900; }
.choose-plus { margin-right:10rpx; color:#7acb00; font-size:35rpx; }
.source-card { margin-top:20rpx; overflow:hidden; border-radius:27rpx; background:#f6f7f3; }
.source-image { display:block; width:100%; height:390rpx; background:#eceee8; }
.source-meta { display:block; padding:17rpx 22rpx; color:#7e837a; font-size:18rpx; line-height:23rpx; font-weight:750; }
.primary-button { display:flex; align-items:center; justify-content:center; width:100%; min-height:92rpx; margin-top:24rpx; border-radius:28rpx; background:#111; color:#b7ff38; font-size:27rpx; font-weight:950; }
.primary-button[disabled],.save-button[disabled] { opacity:.5; }
.result-section { margin-top:35rpx; }
.section-head { display:flex; align-items:center; justify-content:space-between; margin-bottom:20rpx; }
.section-title,.section-desc { display:block; }
.section-title { font-size:31rpx; line-height:37rpx; font-weight:950; }
.section-desc { margin-top:5rpx; color:#858a81; font-size:18rpx; line-height:23rpx; }
.save-button { display:flex; align-items:center; justify-content:center; min-height:58rpx; padding:0 22rpx; border-radius:999rpx; background:#b7ff38; color:#111; font-size:20rpx; font-weight:950; }
.tile-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:8rpx; padding:8rpx; border-radius:25rpx; background:#111; }
.tile-button { position:relative; height:218rpx; overflow:hidden; background:#eee; }
.tile-image { display:block; width:100%; height:100%; }
.tile-order { position:absolute; left:8rpx; top:8rpx; display:flex; align-items:center; justify-content:center; width:36rpx; height:36rpx; border-radius:18rpx; background:#111; color:#b7ff38; font-size:17rpx; font-weight:950; }
.offscreen-canvas { position:fixed; left:-10000px; top:-10000px; width:1px; height:1px; opacity:0; pointer-events:none; }
