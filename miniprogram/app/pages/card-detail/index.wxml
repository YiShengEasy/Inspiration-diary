<view class="page card-detail-page">
  <view wx:if="{{loading}}" class="status-card">加载中...</view>
  <view wx:elif="{{error && hasCard}}" class="status-card">{{error}}</view>

  <view wx:if="{{hasCard}}" class="detail-card">
    <image wx:if="{{!card.isMd && card.image}}" class="hero-image" src="{{card.image}}" mode="aspectFill"></image>
    <view wx:else class="hero-md">
      <view class="hero-md-paper">
        <text class="hero-md-title">{{card.title}}</text>
        <text class="hero-md-summary">{{card.summary}}</text>
      </view>
    </view>

    <view class="detail-copy">
      <text class="type-pill">{{card.typeLabel}}</text>
      <text class="title">{{card.title}}</text>
      <text class="meta">{{card.createdText}}</text>
      <text wx:if="{{card.summary}}" class="summary">{{card.summary}}</text>
    </view>

    <view wx:if="{{card.isCombo && comboDetail}}" class="combo-section">
      <text class="combo-title">参考图片</text>
      <view wx:if="{{comboDetail.images.length}}" class="combo-image-grid">
        <view wx:for="{{comboDetail.images}}" wx:key="id" class="combo-image-card">
          <image src="{{item.imageUrl}}" mode="aspectFill"></image>
          <text>{{item.roleLabel}}</text>
        </view>
      </view>
      <text wx:else class="combo-empty">暂无参考图片</text>

      <text class="combo-title">生成记录</text>
      <view wx:if="{{comboDetail.generations.length}}" class="combo-generation-list">
        <view wx:for="{{comboDetail.generations}}" wx:key="id" class="combo-generation">
          <video src="{{item.videoUrl}}" poster="{{item.posterUrl}}" controls object-fit="contain"></video>
          <view class="combo-generation-copy">
            <text class="combo-prompt">{{item.promptNote}}</text>
            <button class="mini-icon-button" data-url="{{item.videoUrl}}" bindtap="downloadComboVideo">↓</button>
          </view>
        </view>
      </view>
      <text wx:else class="combo-empty">暂无生成记录</text>
    </view>

    <view class="tag-list">
      <text wx:for="{{card.terms}}" wx:key="*this" class="tag">#{{item}}</text>
      <text wx:if="{{!card.terms.length}}" class="empty-tags">暂无标签</text>
    </view>

    <view class="field">
      <text class="field-label">Card ID</text>
      <text class="field-value">{{id}}</text>
    </view>

    <view class="detail-actions">
      <button class="detail-icon-button" bindtap="downloadCardAsset">↓</button>
      <button class="detail-icon-button danger" bindtap="deleteCard">×</button>
    </view>
  </view>

  <view wx:else class="shell-card">
    <text class="shell-title">卡片详情暂不可用</text>
    <text class="shell-desc">{{error || '请从日视图或搜索结果重新打开。'}}</text>
    <text class="shell-id">Card ID: {{id}}</text>
    <button bindtap="openSearch">去搜索</button>
  </view>
</view>
