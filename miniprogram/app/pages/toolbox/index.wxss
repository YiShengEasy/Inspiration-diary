.toolbox-page {
  min-height: 100vh;
  background: #ffffff;
  padding: 0 31rpx 170rpx;
}

button {
  margin: 0;
  padding: 0;
  border: 0;
  line-height: 1;
}

button::after {
  border: 0;
}

.promo-banner {
  position: relative;
  min-height: 268rpx;
  margin: 0 -31rpx;
  padding: 38rpx 38rpx 31rpx;
  box-sizing: border-box;
  overflow: hidden;
  display: flex;
  align-items: flex-end;
  background: radial-gradient(circle at 160rpx 230rpx, rgba(255, 255, 255, 0.72), transparent 34%),
    radial-gradient(circle at 86% 112rpx, rgba(183, 255, 56, 0.48), transparent 27%),
    linear-gradient(118deg, #eaf1ff 0%, #d9d0ff 46%, #c8e8ff 100%);
  color: #171736;
}

.promo-copy {
  position: relative;
  z-index: 2;
  width: 307rpx;
}

.eyebrow {
  display: block;
  font-size: 21rpx;
  line-height: 26rpx;
  font-weight: 900;
  color: #5742c8;
}

.title {
  display: block;
  margin-top: 12rpx;
  font-size: 52rpx;
  line-height: 56rpx;
  font-weight: 900;
}

.subtitle {
  display: block;
  width: 321rpx;
  margin-top: 12rpx;
  font-size: 21rpx;
  line-height: 28rpx;
  color: rgba(33, 32, 72, 0.64);
}

.promo-stack {
  position: absolute;
  right: -17rpx;
  top: 28rpx;
  width: 241rpx;
  height: 195rpx;
}

.promo-image {
  position: absolute;
  width: 126rpx;
  height: 157rpx;
  object-fit: cover;
  border: 7rpx solid rgba(255, 255, 255, 0.88);
  border-radius: 24rpx;
  box-shadow: 0 21rpx 49rpx rgba(61, 55, 139, 0.22);
  box-sizing: border-box;
}

.promo-image-0 {
  left: 0;
  top: 16rpx;
  transform: rotate(-9deg);
}

.promo-image-1 {
  left: 77rpx;
  top: -3rpx;
  transform: rotate(8deg);
}

.promo-image-2 {
  left: 45rpx;
  top: 77rpx;
  transform: rotate(2deg);
}

.featured {
  display: grid;
  grid-template-columns: 1.18fr 0.82fr;
  grid-template-rows: repeat(2, 112rpx);
  gap: 17rpx;
  margin: 28rpx 0;
}

.feature {
  position: relative;
  overflow: hidden;
  min-height: 112rpx;
  padding: 23rpx;
  box-sizing: border-box;
  border-radius: 45rpx 17rpx 45rpx 17rpx;
  display: grid;
  align-content: end;
  justify-items: start;
  align-items: flex-start;
  text-align: left;
  background: #111111;
  color: #ffffff;
}

.feature::before {
  content: "";
  position: absolute;
  right: -40rpx;
  top: -40rpx;
  width: 174rpx;
  height: 174rpx;
  border-radius: 52rpx;
  background: rgba(255, 255, 255, 0.18);
  transform: rotate(14deg);
}

.feature.main-feature {
  grid-row: span 2;
  min-height: 241rpx;
  border-radius: 31rpx;
  background: #b7ff38;
  color: #111111;
}

.feature.main-feature::before {
  width: 230rpx;
  height: 230rpx;
  border-radius: 68rpx;
  background: rgba(255, 255, 255, 0.42);
}

.feature.side-feature {
  background: #111111;
  color: #ffffff;
}

.feature-label,
.feature-icon,
.feature-title,
.feature-desc {
  position: relative;
  z-index: 1;
  display: block;
}

.feature-label {
  width: auto;
  padding: 7rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.44);
  font-size: 19rpx;
  line-height: 22rpx;
  font-weight: 950;
}

.side-feature .feature-label {
  background: rgba(183, 255, 56, 0.18);
  color: #b7ff38;
}

.feature-icon {
  position: absolute;
  right: 26rpx;
  top: 26rpx;
  z-index: 1;
  color: currentColor;
  font-size: 52rpx;
  line-height: 1;
  font-weight: 900;
}

.feature-title {
  margin-top: 21rpx;
  font-size: 26rpx;
  line-height: 26rpx;
  font-weight: 900;
}

.feature.main-feature .feature-title {
  font-size: 42rpx;
  line-height: 42rpx;
}

.feature.side-feature .feature-title {
  margin-top: 12rpx;
}

.feature-desc {
  margin-top: 12rpx;
  font-size: 21rpx;
  line-height: 26rpx;
  font-weight: 700;
  color: rgba(17, 17, 17, 0.62);
}

.feature.side-feature .feature-desc {
  display: none;
}

.category-tabs {
  width: 100%;
  margin: 14rpx 0 24rpx;
  white-space: nowrap;
}

.category {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 49rpx;
  margin-right: 14rpx;
  padding: 0 26rpx;
  border-radius: 999rpx;
  background: #f4f4ef;
  color: #72766d;
  font-size: 21rpx;
  font-weight: 800;
}

.category.active {
  background: #101010;
  color: #ffffff;
}

.tool-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 31rpx 14rpx;
}

.tool-card {
  position: relative;
  min-height: 150rpx;
  padding: 14rpx 7rpx;
  box-sizing: border-box;
  border-radius: 31rpx;
  display: grid;
  place-items: center;
  gap: 9rpx;
  text-align: center;
  background: #ffffff;
  color: #161712;
}

.tool-card.green,
.tool-card.lime {
  background: #f2ffe2;
}

.tool-card.color {
  background: linear-gradient(135deg, #f7ffe9, #eef3ff 55%, #fff1ed);
}

.tool-card.ink {
  background: #f7f7f7;
}

.tool-card.mint,
.tool-card.soft,
.tool-card.plain {
  background: #ffffff;
}

.tool-card.locked {
  opacity: 0.82;
}

.tool-icon {
  display: block;
  color: #111111;
  font-size: 49rpx;
  line-height: 49rpx;
  font-weight: 900;
}

.lock-icon {
  position: absolute;
  right: 16rpx;
  top: 14rpx;
  color: #7c8275;
  font-size: 24rpx;
  line-height: 1;
}

.tool-name {
  display: block;
  font-size: 23rpx;
  line-height: 23rpx;
  font-weight: 900;
}

.tool-desc {
  display: block;
  font-size: 16rpx;
  line-height: 19rpx;
  color: #888d84;
  font-weight: 700;
}

.recommend {
  margin-top: 49rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.section-title {
  display: block;
  color: #151712;
  font-size: 38rpx;
  line-height: 42rpx;
  font-weight: 950;
}

.section-action {
  display: inline-flex;
  align-items: center;
  gap: 5rpx;
  height: 56rpx;
  padding: 0 17rpx;
  border-radius: 999rpx;
  background: #f5f5f1;
  color: #575b52;
  font-size: 21rpx;
  line-height: 25rpx;
  font-weight: 800;
}

.section-arrow {
  font-size: 28rpx;
  line-height: 1;
}

.rec-scroll {
  width: 100%;
  white-space: nowrap;
}

.rec-strip {
  display: inline-flex;
  gap: 24rpx;
  padding: 0 0 17rpx;
}

.rec-card {
  flex: 0 0 220rpx;
  width: 220rpx;
  overflow: hidden;
  text-align: left;
  background: #ffffff;
}

.rec-preview {
  position: relative;
  width: 220rpx;
  height: 276rpx;
  overflow: hidden;
  border-radius: 16rpx;
  background: #f0eee7;
}

.rec-image {
  display: block;
  width: 100%;
  height: 100%;
  background: #f0e6d7;
}

.rec-type-chip {
  position: absolute;
  left: 12rpx;
  top: 12rpx;
  min-width: 58rpx;
  padding: 8rpx 10rpx;
  box-sizing: border-box;
  border-radius: 7rpx;
  background: #111111;
  color: #b7ff38;
  font-size: 18rpx;
  line-height: 20rpx;
  font-weight: 900;
  text-align: center;
}

.rec-md-preview {
  width: 100%;
  height: 100%;
  padding: 31rpx 21rpx;
  box-sizing: border-box;
  background: #ece9df;
}

.rec-paper {
  height: 100%;
  padding: 35rpx 24rpx;
  box-sizing: border-box;
  transform: rotate(-2deg);
  background: #ffffff;
  box-shadow: 0 17rpx 35rpx rgba(70, 56, 32, 0.14);
}

.paper-title,
.paper-line {
  display: block;
}

.paper-title {
  margin-bottom: 24rpx;
  color: #25271f;
  font-size: 21rpx;
  line-height: 24rpx;
  font-weight: 900;
}

.paper-line {
  width: 100%;
  height: 8rpx;
  margin-bottom: 14rpx;
  border-radius: 4rpx;
  background: #daddd3;
}

.paper-line.short {
  width: 58%;
  background: #a8b783;
}

.paper-line.medium {
  width: 76%;
}

.rec-combo-preview {
  position: relative;
  width: 100%;
  height: 100%;
  padding: 12rpx;
  box-sizing: border-box;
  background: #e9e9e3;
}

.rec-combo-images {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 5rpx;
  height: 164rpx;
}

.rec-combo-images image {
  width: 100%;
  height: 164rpx;
}

.rec-combo-video {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 79rpx;
  margin-top: 7rpx;
  border-radius: 7rpx;
  background: #111111;
  color: #b7ff38;
  font-size: 27rpx;
  line-height: 1;
}

.rec-title {
  display: block;
  margin-top: 14rpx;
  color: #151712;
  font-size: 23rpx;
  line-height: 28rpx;
  font-weight: 800;
}

.rec-meta {
  display: block;
  margin-top: 5rpx;
  color: #7b8076;
  font-size: 18rpx;
  line-height: 23rpx;
  font-weight: 700;
}

.empty-state {
  min-height: 220rpx;
  padding: 42rpx;
  box-sizing: border-box;
  border-radius: 28rpx;
  background: #f7f7f2;
}

.empty-title,
.empty-desc {
  display: block;
}

.empty-title {
  font-size: 26rpx;
  line-height: 31rpx;
  font-weight: 900;
}

.empty-desc {
  margin-top: 12rpx;
  font-size: 21rpx;
  line-height: 28rpx;
  color: #7c8078;
}
