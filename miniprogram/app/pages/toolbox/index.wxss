.toolbox-page { min-height: 100vh; background: #fff; padding: 0 31rpx 170rpx; }

button {
  margin: 0;
  padding: 0;
  border: 0;
  line-height: 1;
}

button::after {
  border: 0;
}

.promo-banner { position: relative; min-height: 246rpx; margin: 0 -31rpx; padding: 34rpx 38rpx 29rpx; box-sizing: border-box; overflow: hidden; display: flex; align-items: flex-end; background: radial-gradient(circle at 160rpx 220rpx, rgba(255,255,255,.72), transparent 34%), radial-gradient(circle at 86% 112rpx, rgba(183,255,56,.38), transparent 27%), linear-gradient(118deg,#eaf1ff 0%,#d9d0ff 46%,#c8e8ff 100%); color:#171736; }

.promo-copy { position:relative; z-index:2; width:340rpx; }

.eyebrow { display:block; font-size:21rpx; line-height:26rpx; font-weight:900; color:#5742c8; }

.title { display:block; margin-top:10rpx; font-size:48rpx; line-height:52rpx; font-weight:950; }

.subtitle { display:block; width:350rpx; margin-top:11rpx; font-size:20rpx; line-height:27rpx; color:rgba(33,32,72,.64); }

.promo-stack { position:absolute; right:-17rpx; top:24rpx; width:241rpx; height:190rpx; }

.promo-image { position:absolute; width:122rpx; height:151rpx; object-fit:cover; border:7rpx solid rgba(255,255,255,.88); border-radius:24rpx; box-shadow:0 21rpx 49rpx rgba(61,55,139,.22); box-sizing:border-box; }

.promo-image-0 {
  left: 0;
  top: 16rpx;
  transform: rotate(-9deg);
}

.promo-image-1 {
  left: 77rpx;
  top: -3rpx;
  transform: rotate(8deg);
}

.promo-image-2 {
  left: 45rpx;
  top: 77rpx;
  transform: rotate(2deg);
}

.search-box { display:flex; align-items:center; min-height:88rpx; margin:28rpx 0 20rpx; padding:0 25rpx; box-sizing:border-box; border:2rpx solid #e7e8e2; border-radius:44rpx; background:#fff; }
.search-icon { flex:0 0 auto; color:#767b72; font-size:38rpx; line-height:1; transform:rotate(-18deg); }
.search-input { flex:1; height:88rpx; margin-left:15rpx; color:#171915; font-size:26rpx; }
.search-clear { width:48rpx; height:48rpx; border-radius:24rpx; background:#f1f2ed; color:#72766e; font-size:32rpx; line-height:48rpx; }

.category-tabs { width:100%; margin:0 0 25rpx; white-space:nowrap; }
.category-row { display:inline-flex; padding-right:20rpx; }

.category { display:inline-flex; align-items:center; justify-content:center; min-height:58rpx; margin-right:12rpx; padding:0 27rpx; border-radius:999rpx; background:#f4f4ef; color:#72766d; font-size:23rpx; font-weight:850; }

.category.active { position:relative; background:#101010; color:#b7ff38; }

.featured-tool { position:relative; display:flex; align-items:center; width:100%; min-height:132rpx; padding:24rpx 30rpx; box-sizing:border-box; overflow:hidden; border-radius:29rpx; text-align:left; background:linear-gradient(105deg,#b7ff38 0%,#d8ff8d 66%,#f2ffd7 100%); color:#111; }
.featured-tool::after { content:""; position:absolute; right:-24rpx; top:-58rpx; width:210rpx; height:170rpx; border-radius:60rpx; background:rgba(255,255,255,.38); transform:rotate(12deg); }
.featured-icon { position:relative; z-index:1; flex:0 0 76rpx; font-size:48rpx; line-height:1; font-weight:900; text-align:center; }
.featured-copy { position:relative; z-index:1; flex:1; min-width:0; margin-left:20rpx; }
.featured-name,.featured-desc { display:block; }
.featured-name { font-size:31rpx; line-height:36rpx; font-weight:950; }
.featured-desc { margin-top:8rpx; color:rgba(17,17,17,.58); font-size:20rpx; line-height:25rpx; font-weight:700; }
.featured-arrow { position:relative; z-index:1; display:flex; align-items:center; justify-content:center; width:62rpx; height:62rpx; border-radius:31rpx; background:rgba(255,255,255,.62); font-size:43rpx; line-height:1; }

.tool-grid,.search-grid { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:14rpx; margin-top:20rpx; }
.grid-tool { min-height:174rpx; padding:20rpx 9rpx 16rpx; box-sizing:border-box; border-radius:25rpx; display:flex; flex-direction:column; align-items:center; justify-content:center; text-align:center; background:#f7f7f5; color:#141512; }
.grid-tool.tinted { background:linear-gradient(145deg,#efffd7,#f8fff0); }
.grid-icon,.grid-name,.grid-desc { display:block; }
.grid-icon { min-height:49rpx; font-size:38rpx; line-height:49rpx; font-weight:950; }
.grid-name { width:100%; margin-top:8rpx; overflow:hidden; font-size:20rpx; line-height:25rpx; font-weight:900; text-overflow:ellipsis; white-space:nowrap; }
.grid-desc { width:100%; margin-top:7rpx; overflow:hidden; color:#8a8e86; font-size:15rpx; line-height:19rpx; font-weight:650; text-overflow:ellipsis; white-space:nowrap; }

.compact-tools { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:10rpx 14rpx; margin-top:18rpx; }
.compact-tool { display:flex; align-items:center; min-height:88rpx; padding:14rpx 16rpx; box-sizing:border-box; border-radius:23rpx; text-align:left; background:#f8f8f6; color:#141512; }
.compact-icon { flex:0 0 47rpx; font-size:29rpx; line-height:1; font-weight:950; text-align:center; }
.compact-copy { flex:1; min-width:0; margin-left:10rpx; }
.compact-name,.compact-desc { display:block; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.compact-name { font-size:20rpx; line-height:25rpx; font-weight:900; }
.compact-desc { margin-top:4rpx; color:#92968e; font-size:15rpx; line-height:18rpx; }
.compact-arrow { color:#666b63; font-size:26rpx; }

.search-section { margin-top:4rpx; }
.result-count { color:#878c83; font-size:19rpx; font-weight:700; }
.empty-state { min-height:220rpx; padding:42rpx; box-sizing:border-box; border-radius:28rpx; background:#f7f7f2; }
.empty-title,.empty-desc { display:block; }
.empty-title { color:#1c1e19; font-size:25rpx; line-height:31rpx; font-weight:900; }
.empty-desc { margin-top:10rpx; color:#858a81; font-size:20rpx; line-height:27rpx; }

.recent { margin-top:35rpx; }
.compact-head { margin-bottom:18rpx; }
.text-action { color:#71766d; background:transparent; font-size:20rpx; line-height:24rpx; font-weight:750; }
.recent-scroll { width:100%; white-space:nowrap; }
.recent-strip { display:inline-flex; gap:12rpx; padding-right:20rpx; }
.recent-tool { display:flex; align-items:center; width:236rpx; min-height:78rpx; padding:12rpx 15rpx; box-sizing:border-box; border-radius:19rpx; text-align:left; background:linear-gradient(135deg,#efffd3,#f7ffe9); color:#171915; }
.recent-icon { flex:0 0 43rpx; font-size:28rpx; line-height:1; font-weight:950; text-align:center; }
.recent-copy { min-width:0; margin-left:9rpx; }
.recent-name,.recent-desc { display:block; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.recent-name { font-size:19rpx; line-height:23rpx; font-weight:900; }
.recent-desc { width:150rpx; margin-top:3rpx; color:#7e8578; font-size:14rpx; line-height:18rpx; }

.all-tools { display:flex; align-items:center; justify-content:center; width:100%; min-height:79rpx; margin-top:25rpx; padding:0 25rpx; box-sizing:border-box; border-radius:22rpx; background:#f6f6f4; color:#171915; font-size:23rpx; font-weight:900; }
.all-icon { margin-right:14rpx; font-size:29rpx; }
.all-arrow { margin-left:auto; color:#5d625a; font-size:32rpx; }
.privacy-tip { display:flex; align-items:center; justify-content:center; gap:9rpx; margin-top:17rpx; color:#969b92; font-size:17rpx; line-height:22rpx; font-weight:700; }
.privacy-lock { font-size:19rpx; }

.recommend {
  margin-top: 49rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.section-title {
  display: block;
  color: #151712;
  font-size: 38rpx;
  line-height: 42rpx;
  font-weight: 950;
}

.section-action {
  display: inline-flex;
  align-items: center;
  gap: 5rpx;
  height: 56rpx;
  padding: 0 17rpx;
  border-radius: 999rpx;
  background: #f5f5f1;
  color: #575b52;
  font-size: 21rpx;
  line-height: 25rpx;
  font-weight: 800;
}

.section-arrow {
  font-size: 28rpx;
  line-height: 1;
}

.rec-scroll {
  width: 100%;
  white-space: nowrap;
}

.rec-strip {
  display: inline-flex;
  gap: 24rpx;
  padding: 0 0 17rpx;
}

.rec-card {
  flex: 0 0 220rpx;
  width: 220rpx;
  overflow: hidden;
  text-align: left;
  background: #ffffff;
}

.rec-preview {
  position: relative;
  width: 220rpx;
  height: 276rpx;
  overflow: hidden;
  border-radius: 16rpx;
  background: #f0eee7;
}

.rec-image {
  display: block;
  width: 100%;
  height: 100%;
  background: #f0e6d7;
}

.rec-type-chip {
  position: absolute;
  left: 12rpx;
  top: 12rpx;
  min-width: 58rpx;
  padding: 8rpx 10rpx;
  box-sizing: border-box;
  border-radius: 7rpx;
  background: #111111;
  color: #b7ff38;
  font-size: 18rpx;
  line-height: 20rpx;
  font-weight: 900;
  text-align: center;
}

.rec-md-preview {
  width: 100%;
  height: 100%;
  padding: 31rpx 21rpx;
  box-sizing: border-box;
  background: #ece9df;
}

.rec-paper {
  height: 100%;
  padding: 35rpx 24rpx;
  box-sizing: border-box;
  transform: rotate(-2deg);
  background: #ffffff;
  box-shadow: 0 17rpx 35rpx rgba(70, 56, 32, 0.14);
}

.paper-title,
.paper-line {
  display: block;
}

.paper-title {
  margin-bottom: 24rpx;
  color: #25271f;
  font-size: 21rpx;
  line-height: 24rpx;
  font-weight: 900;
}

.paper-line {
  width: 100%;
  height: 8rpx;
  margin-bottom: 14rpx;
  border-radius: 4rpx;
  background: #daddd3;
}

.paper-line.short {
  width: 58%;
  background: #a8b783;
}

.paper-line.medium {
  width: 76%;
}

.rec-combo-preview {
  position: relative;
  width: 100%;
  height: 100%;
  padding: 12rpx;
  box-sizing: border-box;
  background: #e9e9e3;
}

.rec-combo-images {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 5rpx;
  height: 164rpx;
}

.rec-combo-images image {
  width: 100%;
  height: 164rpx;
}

.rec-combo-video {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 79rpx;
  margin-top: 7rpx;
  border-radius: 7rpx;
  background: #111111;
  color: #b7ff38;
  font-size: 27rpx;
  line-height: 1;
}

.rec-title {
  display: block;
  margin-top: 14rpx;
  color: #151712;
  font-size: 23rpx;
  line-height: 28rpx;
  font-weight: 800;
}

.rec-meta {
  display: block;
  margin-top: 5rpx;
  color: #7b8076;
  font-size: 18rpx;
  line-height: 23rpx;
  font-weight: 700;
}
