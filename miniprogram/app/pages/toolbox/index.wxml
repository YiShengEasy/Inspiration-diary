<view class="page toolbox-page">
  <view class="promo-banner">
    <view class="promo-copy">
      <text class="eyebrow">Inspiration Diary</text>
      <text class="title">AI 灵感册</text>
      <text class="subtitle">图片、文字、文档，一键整理成每天的灵感记录。</text>
    </view>
    <view class="promo-stack" aria-hidden="true">
      <image wx:for="{{promoImages}}" wx:key="*this" class="promo-image promo-image-{{index}}" src="{{item}}" mode="aspectFill"></image>
    </view>
  </view>

  <view class="search-box">
    <text class="search-icon">⌕</text>
    <input class="search-input" value="{{searchKeyword}}" placeholder="搜索工具" bindinput="searchTools" confirm-type="search" />
    <button wx:if="{{searchKeyword}}" class="search-clear" bindtap="clearSearch">×</button>
  </view>

  <scroll-view class="category-tabs" scroll-x enable-flex show-scrollbar="{{false}}">
    <view class="category-row">
      <button wx:for="{{categories}}" wx:key="*this" class="category {{category === item ? 'active' : ''}}" data-category="{{item}}" bindtap="selectCategory">{{item}}</button>
    </view>
  </scroll-view>

  <view wx:if="{{isSearching}}" class="search-section">
    <view class="section-head compact-head">
      <text class="section-title">搜索结果</text>
      <text class="result-count">{{searchResults.length}} 个工具</text>
    </view>
    <view class="search-grid" wx:if="{{searchResults.length}}">
      <button wx:for="{{searchResults}}" wx:key="id" class="grid-tool" data-id="{{item.id}}" bindtap="openTool">
        <text class="grid-icon">{{item.iconText}}</text>
        <text class="grid-name">{{item.name}}</text>
        <text class="grid-desc">{{item.desc}}</text>
      </button>
    </view>
    <view class="empty-state" wx:else>
      <text class="empty-title">没有找到这个工具</text>
      <text class="empty-desc">换个关键词试试，或从分类中浏览。</text>
    </view>
  </view>

  <block wx:else>
    <button wx:if="{{featuredTool}}" class="featured-tool" data-id="{{featuredTool.id}}" bindtap="openTool">
      <text class="featured-icon">{{featuredTool.iconText}}</text>
      <view class="featured-copy">
        <text class="featured-name">{{featuredTool.name}}</text>
        <text class="featured-desc">{{featuredTool.desc}}</text>
      </view>
      <text class="featured-arrow">›</text>
    </button>

    <view class="tool-grid" wx:if="{{gridTools.length}}">
      <button wx:for="{{gridTools}}" wx:key="id" class="grid-tool {{index === 0 ? 'tinted' : ''}}" data-id="{{item.id}}" bindtap="openTool">
        <text class="grid-icon">{{item.iconText}}</text>
        <text class="grid-name">{{item.name}}</text>
        <text class="grid-desc">{{item.desc}}</text>
      </button>
    </view>

    <view class="compact-tools" wx:if="{{listTools.length}}">
      <button wx:for="{{listTools}}" wx:key="id" class="compact-tool" data-id="{{item.id}}" bindtap="openTool">
        <text class="compact-icon">{{item.iconText}}</text>
        <view class="compact-copy">
          <text class="compact-name">{{item.name}}</text>
          <text class="compact-desc">{{item.desc}}</text>
        </view>
        <text class="compact-arrow">›</text>
      </button>
    </view>

    <view class="recent" wx:if="{{recentTools.length}}">
      <view class="section-head compact-head">
        <text class="section-title">最近使用</text>
        <button class="text-action" bindtap="clearRecentTools">清空</button>
      </view>
      <scroll-view class="recent-scroll" scroll-x enhanced show-scrollbar="{{false}}">
        <view class="recent-strip">
          <button wx:for="{{recentTools}}" wx:key="id" class="recent-tool" data-id="{{item.id}}" bindtap="openTool">
            <text class="recent-icon">{{item.iconText}}</text>
            <view class="recent-copy">
              <text class="recent-name">{{item.name}}</text>
              <text class="recent-desc">{{item.desc}}</text>
            </view>
          </button>
        </view>
      </scroll-view>
    </view>

    <button wx:if="{{!allExpanded}}" class="all-tools" bindtap="showAllTools">
      <text class="all-icon">▦</text>
      <text>查看全部{{category}}工具</text>
      <text class="all-arrow">›</text>
    </button>

    <view class="privacy-tip">
      <text class="privacy-lock">▢</text>
      <text>本地工具优先处理 · 内容不主动上传</text>
    </view>
  </block>

  <view class="recommend">
    <view class="section-head">
      <text class="section-title">为你推荐</text>
      <button class="section-action" bindtap="openDiary">
        <text>看灵感册</text>
        <text class="section-arrow">›</text>
      </button>
    </view>
    <scroll-view class="rec-scroll" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="rec-strip">
        <button wx:for="{{recommendCards}}" wx:key="type" class="rec-card" data-reference="{{item.type}}" bindtap="openReferenceCard">
          <view class="rec-preview">
            <image wx:if="{{item.type === 'image'}}" class="rec-image" src="{{item.image}}" mode="aspectFill"></image>
            <view wx:elif="{{item.type === 'md'}}" class="rec-md-preview">
              <view class="rec-paper">
                <text class="paper-title">周末手记</text>
                <text class="paper-line short"></text>
                <text class="paper-line"></text>
                <text class="paper-line"></text>
                <text class="paper-line medium"></text>
              </view>
            </view>
            <view wx:else class="rec-combo-preview">
              <view class="rec-combo-images">
                <image wx:for="{{item.images}}" wx:key="*this" src="{{item}}" mode="aspectFill"></image>
              </view>
              <view class="rec-combo-video"><text>▶</text></view>
            </view>
            <text class="rec-type-chip">{{item.typeLabel}}</text>
          </view>
          <text class="rec-title">{{item.title}}</text>
          <text class="rec-meta">{{item.meta}}</text>
        </button>
      </view>
    </scroll-view>
  </view>
</view>
