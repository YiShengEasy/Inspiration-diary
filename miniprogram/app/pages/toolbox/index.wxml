<view class="page toolbox-page">
  <view class="promo-banner">
    <view class="promo-copy">
      <text class="eyebrow">免费工具先试用</text>
      <text class="title">把图片灵感收进每天的日记</text>
      <text class="subtitle">图片、手稿、标签，一键整理成每周记录。</text>
    </view>
    <view class="promo-stack" aria-hidden="true">
      <image wx:for="{{promoImages}}" wx:key="*this" class="promo-image promo-image-{{index}}" src="{{item}}" mode="aspectFill"></image>
    </view>
  </view>

  <view class="featured">
    <block wx:for="{{featuredTools}}" wx:key="id">
      <button data-id="{{item.id}}" bindtap="openTool" class="feature {{item.featureClass}}">
        <text class="feature-label">{{item.label}}</text>
        <text class="feature-icon icon icon-{{item.iconKey}}">{{item.iconText}}</text>
        <text class="feature-title">{{item.name}}</text>
        <text class="feature-desc">{{item.desc}}</text>
      </button>
    </block>
  </view>

  <scroll-view class="category-tabs" scroll-x enable-flex>
    <block wx:for="{{categories}}" wx:key="*this">
      <button class="category {{category === item ? 'active' : ''}}" data-category="{{item}}" bindtap="selectCategory">{{item}}</button>
    </block>
  </scroll-view>

  <view class="tool-grid" wx:if="{{visibleTools.length}}">
    <block wx:for="{{visibleTools}}" wx:key="id">
      <button class="tool-card {{item.accent}}" data-id="{{item.id}}" bindtap="openTool">
        <text wx:if="{{item.locked}}" class="lock-icon">⌕</text>
        <text class="tool-icon icon icon-{{item.iconKey}}">{{item.iconText}}</text>
        <text class="tool-name">{{item.name}}</text>
        <text class="tool-desc">{{item.desc}}</text>
      </button>
    </block>
  </view>

  <view class="empty-state" wx:else>
    <text class="empty-title">这个分类还在整理</text>
    <text class="empty-desc">先试试常用工具，后续会补充更多能力。</text>
  </view>

  <view class="recommend">
    <view class="section-head">
      <text class="section-title">为你推荐</text>
      <button class="section-action" bindtap="openDiary">
        <text>看灵感册</text>
        <text class="section-arrow">›</text>
      </button>
    </view>
    <scroll-view class="rec-scroll" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="rec-strip">
        <view wx:for="{{recommendCards}}" wx:key="title" class="rec-card">
          <image class="rec-image" src="{{item.image}}" mode="aspectFill"></image>
          <text class="rec-title">{{item.title}}</text>
        </view>
      </view>
    </scroll-view>
  </view>
</view>
