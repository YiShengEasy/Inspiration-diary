<view class="page count-page">
  <view class="hero-card">
    <text class="hero-kicker">本地文字工具</text>
    <text class="hero-title">字数统计</text>
    <text class="hero-desc">实时统计字符、中文、单词、段落和阅读时长。</text>
  </view>

  <view class="stats-grid">
    <view class="stat-card primary"><text class="stat-value">{{stats.total}}</text><text class="stat-label">总字符</text></view>
    <view class="stat-card"><text class="stat-value">{{stats.noSpaces}}</text><text class="stat-label">不含空格</text></view>
    <view class="stat-card"><text class="stat-value">{{stats.chinese}}</text><text class="stat-label">中文字符</text></view>
    <view class="stat-card"><text class="stat-value">{{stats.words}}</text><text class="stat-label">英文单词</text></view>
    <view class="stat-card"><text class="stat-value">{{stats.lines}}</text><text class="stat-label">行数</text></view>
    <view class="stat-card"><text class="stat-value">{{stats.paragraphs}}</text><text class="stat-label">段落</text></view>
  </view>

  <view class="reading-card">
    <view><text class="reading-title">预计阅读时长</text><text class="reading-desc">按照每分钟约 300 字估算</text></view>
    <text class="reading-value">{{stats.readingMinutes}} 分钟</text>
  </view>

  <view class="editor-head">
    <text class="section-title">统计文本</text>
    <view class="head-actions">
      <button class="head-button" bindtap="pasteText">粘贴</button>
      <button class="head-button" bindtap="copyText">复制</button>
      <button class="head-button" bindtap="clearText">清空</button>
    </view>
  </view>
  <view class="text-box">
    <textarea class="text-input" value="{{text}}" placeholder="输入或粘贴文字，统计结果会实时更新…" maxlength="-1" bindinput="changeText"></textarea>
  </view>
</view>
