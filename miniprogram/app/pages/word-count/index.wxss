.count-page { min-height:100vh; padding:28rpx 31rpx 120rpx; box-sizing:border-box; background:#fff; color:#151712; }
button { margin:0; padding:0; border:0; line-height:1; }
button::after { border:0; }
.hero-card { position:relative; overflow:hidden; min-height:210rpx; padding:34rpx; box-sizing:border-box; border-radius:34rpx; background:linear-gradient(118deg,#e9edff,#ded4ff 52%,#d9f8ec); }
.hero-card::after { content:""; position:absolute; right:-25rpx; top:-70rpx; width:240rpx; height:230rpx; border-radius:76rpx; background:rgba(183,255,56,.38); transform:rotate(13deg); }
.hero-kicker,.hero-title,.hero-desc { position:relative; z-index:1; display:block; }
.hero-kicker { color:#5742c8; font-size:20rpx; line-height:24rpx; font-weight:900; }
.hero-title { margin-top:12rpx; font-size:49rpx; line-height:55rpx; font-weight:950; }
.hero-desc { width:455rpx; margin-top:13rpx; color:rgba(28,27,62,.62); font-size:21rpx; line-height:29rpx; }
.stats-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:12rpx; margin-top:26rpx; }
.stat-card { min-height:125rpx; padding:19rpx 12rpx; box-sizing:border-box; border-radius:24rpx; display:flex; flex-direction:column; align-items:center; justify-content:center; background:#f6f7f3; }
.stat-card.primary { background:linear-gradient(145deg,#c8ff68,#efffd5); }
.stat-value,.stat-label { display:block; }
.stat-value { font-size:35rpx; line-height:40rpx; font-weight:950; }
.stat-label { margin-top:7rpx; color:#73786f; font-size:17rpx; line-height:21rpx; font-weight:800; }
.reading-card { display:flex; align-items:center; justify-content:space-between; margin-top:15rpx; padding:21rpx 24rpx; border-radius:24rpx; background:#111; color:#fff; }
.reading-title,.reading-desc { display:block; }
.reading-title { font-size:21rpx; line-height:26rpx; font-weight:900; }
.reading-desc { margin-top:5rpx; color:rgba(255,255,255,.55); font-size:15rpx; }
.reading-value { color:#b7ff38; font-size:25rpx; font-weight:950; }
.editor-head { display:flex; align-items:center; justify-content:space-between; margin:34rpx 0 16rpx; }
.section-title { font-size:29rpx; line-height:35rpx; font-weight:950; }
.head-actions { display:flex; gap:8rpx; }
.head-button { display:flex; align-items:center; justify-content:center; padding:13rpx 16rpx; border-radius:999rpx; background:#f2f3ee; color:#646960; font-size:17rpx; font-weight:850; }
.text-box { min-height:400rpx; padding:20rpx; box-sizing:border-box; border-radius:27rpx; background:#f7f7f4; }
.text-input { width:100%; min-height:360rpx; color:#191b17; font-size:23rpx; line-height:34rpx; }
