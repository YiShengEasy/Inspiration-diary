<view class="page register-page">
  <view class="header">
    <text class="eyebrow">ACCOUNT</text>
    <text class="title">完成账号注册</text>
    <text class="desc">注册后，Web 端可用同一个手机号或邮箱和密码登录。</text>
  </view>

  <view class="phone-card">
    <view>
      <text class="card-title">微信手机号</text>
      <text class="card-desc">{{phone ? phone : '可授权微信手机号自动回填'}}</text>
    </view>
    <button class="phone-button" open-type="getPhoneNumber" bindgetphonenumber="getPhoneNumber">授权绑定</button>
  </view>

  <view class="form">
    <view class="field">
      <text class="label">手机号或邮箱</text>
      <input value="{{identifier}}" placeholder="请输入手机号或邮箱" bindinput="onIdentifierInput" />
    </view>
    <view class="field">
      <text class="label">登录密码</text>
      <input value="{{password}}" password placeholder="设置至少 8 位密码" bindinput="onPasswordInput" />
    </view>
    <button class="submit" loading="{{submitting}}" bindtap="submit">完成注册</button>
  </view>
</view>
