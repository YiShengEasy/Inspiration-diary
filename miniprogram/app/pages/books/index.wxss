.page {
  height: 100vh;
  box-sizing: border-box;
  background: #fffaf1;
  color: #111111;
  overflow: hidden;
}

button {
  box-sizing: border-box;
  margin: 0;
  border: 0;
  padding: 0;
  background: transparent;
  color: inherit;
  font: inherit;
  line-height: normal;
  text-align: left;
}

button::after {
  border: 0;
}

.books-workspace {
  height: 100vh;
  min-height: 0;
  display: grid;
  grid-template-columns: 230rpx 1fr;
  overflow: hidden;
}

.books-sidebar {
  min-width: 0;
  height: 100vh;
  min-height: 0;
  padding: 24rpx 16rpx 190rpx;
  box-sizing: border-box;
  border-right: 2rpx solid #e9dfce;
  background:
    linear-gradient(rgba(255, 255, 255, 0.5), rgba(255, 255, 255, 0.12)),
    repeating-linear-gradient(0deg, transparent 0 40rpx, rgba(154, 128, 100, 0.06) 42rpx);
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.bookshelf-label {
  display: block;
  color: #83776a;
  font-size: 19rpx;
  line-height: 24rpx;
  font-weight: 950;
  letter-spacing: 8rpx;
  margin-bottom: 17rpx;
}

.book-search {
  height: 59rpx;
  display: flex;
  align-items: center;
  gap: 9rpx;
  border-radius: 21rpx;
  padding: 0 14rpx;
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.82);
  border: 2rpx solid #e8ddca;
  color: #8d7d69;
}

.search-icon {
  font-size: 21rpx;
  line-height: 1;
}

.book-search input {
  min-width: 0;
  width: 100%;
  height: 100%;
  color: #111111;
  font-size: 19rpx;
  font-weight: 800;
}

.book-list {
  flex: 1 1 auto;
  min-height: 0;
  margin: 17rpx 0;
}

.book-list-item {
  display: grid;
  grid-template-columns: 70rpx 1fr;
  gap: 14rpx;
  align-items: center;
  width: 100%;
  min-height: 101rpx;
  border-radius: 26rpx;
  padding: 12rpx;
  margin-bottom: 14rpx;
  background: rgba(255, 255, 255, 0.78);
  border: 2rpx solid transparent;
  box-shadow: 0 14rpx 31rpx rgba(96, 72, 35, 0.08);
}

.book-list-item.active {
  border-color: #d7c9b5;
  background: #ffffff;
  box-shadow: 0 21rpx 42rpx rgba(96, 72, 35, 0.12);
}

.book-list-cover {
  width: 70rpx;
  height: 77rpx;
  border-radius: 17rpx;
  flex-shrink: 0;
}

.empty-cover {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(150deg, #151712, #455238);
  color: #b7ff38;
  font-size: 16rpx;
  font-weight: 950;
}

.book-list-copy {
  min-width: 0;
}

.book-list-title,
.book-list-count {
  display: block;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.book-list-title {
  color: #111111;
  font-size: 21rpx;
  line-height: 23rpx;
  font-weight: 900;
}

.book-list-count {
  margin-top: 7rpx;
  color: #8d7d69;
  font-size: 17rpx;
  line-height: 21rpx;
  font-weight: 850;
}

.book-crud {
  flex: 0 0 auto;
  margin-top: auto;
  display: grid;
  gap: 12rpx;
}

.book-crud button {
  min-height: 63rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 9rpx;
  border-radius: 21rpx;
  background: #111111;
  color: #ffffff;
  font-size: 21rpx;
  font-weight: 950;
}

.book-crud .danger {
  background: #fff0ef;
  color: #d92121;
  border: 2rpx solid #ffd6d2;
}

.book-content {
  min-width: 0;
  width: 100%;
  height: 100vh;
  min-height: 0;
  box-sizing: border-box;
}

.book-content-inner {
  min-height: 100%;
  box-sizing: border-box;
  padding: 28rpx 21rpx 190rpx;
}

.book-title-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 17rpx;
  padding-bottom: 21rpx;
  border-bottom: 2rpx solid #e9dfce;
}

.current-label {
  display: block;
  color: #9a8064;
  font-size: 19rpx;
  line-height: 24rpx;
  font-weight: 950;
}

.current-title {
  display: block;
  margin: 9rpx 0;
  color: #111111;
  font-size: 42rpx;
  line-height: 44rpx;
  font-weight: 950;
}

.current-desc {
  display: block;
  color: #6f6253;
  font-size: 21rpx;
  line-height: 31rpx;
}

.collect-button {
  flex: 0 0 auto;
  min-height: 59rpx;
  display: flex;
  align-items: center;
  gap: 9rpx;
  border-radius: 21rpx;
  background: #b7ff38;
  color: #111111;
  padding: 0 17rpx;
  font-size: 21rpx;
  font-weight: 950;
}

.collect-button[loading] {
  opacity: 0.76;
}

.book-tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin: 21rpx 0;
}

.book-tag-row text {
  border-radius: 999rpx;
  background: #f4ead8;
  color: #8a5a16;
  padding: 7rpx 14rpx;
  font-size: 19rpx;
  line-height: 23rpx;
  font-weight: 900;
}

.upload-status {
  margin: 18rpx 0;
  border-radius: 18rpx;
  border: 2rpx solid #dceec5;
  background: #f4ffe8;
  color: #3b5817;
  padding: 14rpx 18rpx;
  font-size: 20rpx;
  line-height: 26rpx;
  font-weight: 900;
}

.upload-status.active {
  border-color: #ead9b7;
  background: #fff7e8;
  color: #8a5a16;
}

.book-items {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 17rpx;
}

.book-item {
  min-width: 0;
  padding: 14rpx;
  border-radius: 28rpx;
  background: #ffffff;
  border: 2rpx solid #eee4d3;
  box-shadow: 0 17rpx 35rpx rgba(96, 72, 35, 0.08);
}

.book-item.cover {
  grid-column: 1 / -1;
}

.book-item-thumb {
  position: relative;
  aspect-ratio: 4 / 5;
  overflow: hidden;
  border-radius: 23rpx;
  background: #f3f0e9;
}

.book-item.cover .book-item-thumb {
  aspect-ratio: 16 / 10;
}

.book-item-thumb image,
.md-thumb {
  width: 100%;
  height: 100%;
}

.md-thumb {
  position: relative;
  box-sizing: border-box;
  padding: 17rpx;
  overflow: hidden;
  background: linear-gradient(160deg, #ffffff 0%, #fbfaf6 56%, #ede8de 100%);
}

.md-thumb-title,
.md-thumb-summary {
  display: block;
  position: relative;
  z-index: 1;
  overflow: hidden;
  word-break: break-all;
}

.md-thumb-title {
  max-height: 44rpx;
  color: #151712;
  font-size: 20rpx;
  font-weight: 900;
  line-height: 22rpx;
}

.md-thumb-summary {
  margin-top: 10rpx;
  max-height: 74rpx;
  color: #8a8981;
  font-size: 18rpx;
  line-height: 25rpx;
}

.cover-badge {
  position: absolute;
  left: 14rpx;
  top: 14rpx;
  border-radius: 999rpx;
  background: rgba(17, 17, 17, 0.82);
  color: #ffffff;
  padding: 7rpx 14rpx;
  font-size: 17rpx;
  line-height: 21rpx;
  font-weight: 900;
}

.item-title,
.item-tags {
  display: block;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.item-title {
  margin-top: 14rpx;
  color: #111111;
  font-size: 23rpx;
  line-height: 28rpx;
  font-weight: 900;
}

.item-tags {
  margin-top: 9rpx;
  color: #776b5c;
  font-size: 19rpx;
  line-height: 28rpx;
}

.state,
.empty-state {
  margin: 26rpx;
  border-radius: 24rpx;
  padding: 28rpx;
  background: #ffffff;
  color: #777b72;
  font-size: 26rpx;
}

.state.compact,
.empty-state.compact {
  margin: 18rpx 0;
}

.state.error {
  background: #fff0ed;
  color: #b4442f;
}

.empty-state {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  text-align: center;
}

.empty-title {
  color: #151712;
  font-size: 32rpx;
  font-weight: 900;
}

.empty-desc {
  font-size: 25rpx;
}
