<view class="page diary-page">
  <view wx:if="{{accountState !== 'registered'}}" class="diary-preview">
    <view class="preview-hero">
      <view>
        <text class="eyebrow">Inspiration Diary</text>
        <text class="title">把每天的视觉灵感整理成册</text>
        <text class="desc">图片、Markdown、色卡和标签会按日期沉淀，也能收录进不同灵感册。</text>
        <button class="primary-btn" bindtap="openRegister">完成注册</button>
      </view>
      <view class="preview-stack">
        <view class="stack-card first"></view>
        <view class="stack-card second"></view>
        <view class="stack-card third"></view>
      </view>
    </view>

    <view class="preview-grid">
      <view class="preview-item">
        <text class="item-icon">图</text>
        <text class="item-title">图片</text>
        <text class="item-desc">原图 / 缩略图</text>
      </view>
      <view class="preview-item">
        <text class="item-icon">文</text>
        <text class="item-title">文档</text>
        <text class="item-desc">MD 摘要</text>
      </view>
      <view class="preview-item">
        <text class="item-icon">色</text>
        <text class="item-title">色卡</text>
        <text class="item-desc">图片取色</text>
      </view>
      <view class="preview-item">
        <text class="item-icon">AI</text>
        <text class="item-title">总结</text>
        <text class="item-desc">每周整理</text>
      </view>
    </view>
  </view>

  <view wx:else class="weekly-layout">
    <view class="week-switcher">
      <button class="week-nav" hover-class="button-press">‹</button>
      <text class="week-pill-title">{{weekLabel}}</text>
      <button class="week-nav" hover-class="button-press">›</button>
    </view>

    <button class="summary-card" hover-class="button-press">
      <view>
        <text class="summary-label">本周总结</text>
        <text class="summary-title">{{totalCards}} 条灵感 · {{mdCount}} 篇手稿 · {{totalTerms}} 个标签</text>
        <text class="summary-desc">AI 已整理本周风格：自然层次、纸感版式、像素复古。</text>
      </view>
      <text class="summary-action">查看</text>
    </button>

    <view class="books-section">
      <view class="section-head">
        <text class="section-title">我的灵感册</text>
        <button class="manage-button" hover-class="button-press" bindtap="openBooks">
          <text>管理</text>
          <text class="manage-chevron">›</text>
        </button>
      </view>
      <scroll-view class="book-scroll" scroll-x enhanced show-scrollbar="{{false}}">
        <view class="book-strip">
          <view wx:for="{{books}}" wx:key="id" class="book-tile">
            <image wx:if="{{item.coverImage}}" class="book-tile-image" src="{{item.coverImage}}" mode="aspectFill"></image>
            <view wx:else class="book-tile-image empty-book"></view>
            <text class="book-tile-title">{{item.title}}</text>
            <text class="book-tile-count">{{item.cardCountText}}</text>
          </view>
          <view wx:if="{{!books.length}}" class="book-tile placeholder-book" bindtap="openBooks">
            <view class="book-tile-image empty-book"></view>
            <text class="book-tile-title">新建灵感册</text>
            <text class="book-tile-count">开始收纳</text>
          </view>
        </view>
      </scroll-view>
    </view>

    <view wx:if="{{loading}}" class="state">正在加载本周灵感...</view>
    <view wx:if="{{error}}" class="state error">{{error}}</view>

    <view class="day-list">
      <button wx:for="{{cardsByDay}}" wx:key="day" class="day-card" data-index="{{index}}" bindtap="openDay">
        <view class="day-title-row">
          <text class="day-name">{{item.day}}</text>
          <text class="day-count">{{item.countText}}</text>
        </view>
        <view wx:if="{{item.count}}" class="day-content">
          <view class="cover-stack">
            <image
              wx:for="{{item.coverImages}}"
              wx:key="*this"
              class="cover-image stack-{{index}}"
              src="{{item}}"
              mode="aspectFill"
              data-src="{{item}}"
              binderror="onImageError"
            ></image>
            <text wx:if="{{item.count > 1}}" class="more-count">+{{item.count - 1}}</text>
          </view>
          <view class="cover-text">
            <text class="type-pill {{item.cover.typeLabel === 'IMG' ? 'image-pill' : 'md-pill'}}">{{item.cover.typeLabel}}</text>
            <text class="cover-title">{{item.cover.title}}</text>
            <text class="cover-tags">{{item.cover.termsText}}</text>
          </view>
          <text class="chevron">›</text>
        </view>
        <view wx:else class="empty-day">
          <text class="empty-day-icon">＋</text>
          <text>添加今天的灵感</text>
        </view>
      </button>
    </view>

    <button class="upload-fab" loading="{{uploading}}" hover-class="button-press" hover-stay-time="80" bindtap="chooseUpload">
      <text>＋</text>
    </button>
  </view>
</view>
