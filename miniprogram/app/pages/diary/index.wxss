.page {
  min-height: 100vh;
  padding: 31rpx 31rpx 170rpx;
  box-sizing: border-box;
  background: linear-gradient(#fffaf1, #f4efe4);
  color: #151712;
}

button {
  box-sizing: border-box;
  margin: 0;
  border: 0;
  border-radius: 0;
  padding: 0;
  background: transparent;
  color: inherit;
  font: inherit;
  line-height: normal;
  text-align: left;
}

button::after {
  border: 0;
}

.button-press {
  opacity: 0.82;
  transform: scale(0.96);
}

.diary-preview {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.preview-hero {
  position: relative;
  min-height: 340rpx;
  overflow: hidden;
  border-radius: 36rpx;
  padding: 38rpx;
  background: linear-gradient(118deg, #eaf1ff 0%, #d9d0ff 46%, #c8e8ff 100%);
}

.eyebrow,
.caption {
  display: block;
  color: #5b49bf;
  font-size: 21rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}

.title {
  display: block;
  width: 410rpx;
  margin-top: 16rpx;
  color: #171736;
  font-size: 50rpx;
  font-weight: 900;
  line-height: 1.1;
}

.desc {
  display: block;
  width: 430rpx;
  margin-top: 18rpx;
  color: rgba(33, 32, 72, 0.66);
  font-size: 23rpx;
  line-height: 1.45;
}

.primary-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 190rpx;
  height: 72rpx;
  margin-top: 28rpx;
  border-radius: 999rpx;
  background: #b7ff38;
  color: #132006;
  font-size: 28rpx;
  font-weight: 900;
  text-align: center;
}

.preview-stack {
  position: absolute;
  right: 22rpx;
  top: 42rpx;
  width: 220rpx;
  height: 210rpx;
}

.stack-card {
  position: absolute;
  width: 116rpx;
  height: 148rpx;
  border: 8rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 24rpx;
  box-shadow: 0 20rpx 44rpx rgba(61, 55, 139, 0.22);
}

.stack-card.first {
  left: 0;
  top: 26rpx;
  transform: rotate(-9deg);
  background: linear-gradient(150deg, #5d7c68, #d7f2ea);
}

.stack-card.second {
  left: 74rpx;
  top: 0;
  transform: rotate(8deg);
  background: linear-gradient(150deg, #2d334d, #f2c6a0);
}

.stack-card.third {
  left: 44rpx;
  top: 88rpx;
  transform: rotate(2deg);
  background: linear-gradient(150deg, #20251f, #b7ff38);
}

.preview-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}

.preview-item {
  min-height: 156rpx;
  border-radius: 32rpx;
  padding: 20rpx 16rpx;
  background: #ffffff;
  box-shadow: 0 14rpx 34rpx rgba(20, 24, 18, 0.08);
}

.item-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 42rpx;
  height: 42rpx;
  border-radius: 14rpx;
  background: #ecffd8;
  color: #2b4b16;
  font-size: 22rpx;
  font-weight: 900;
  text-align: center;
}

.item-title,
.item-desc {
  display: block;
}

.item-title {
  margin-top: 16rpx;
  font-size: 26rpx;
  font-weight: 900;
}

.item-desc {
  margin-top: 6rpx;
  color: #777b72;
  font-size: 21rpx;
}

.weekly-layout {
  padding-bottom: 130rpx;
}

.diary-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 31rpx;
}

.caption {
  display: block;
  color: #a47c34;
  font-size: 21rpx;
  font-weight: 900;
}

.week-range {
  display: block;
  margin-top: 4rpx;
  color: #111111;
  font-size: 44rpx;
  font-weight: 950;
  line-height: 48rpx;
}

.header-actions {
  display: flex;
  gap: 18rpx;
}

.week-switcher {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 75rpx;
  margin-bottom: 24rpx;
  padding: 0 17rpx;
  border: 2rpx solid #eadcc8;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.82);
}

.week-nav {
  flex: 0 0 54rpx;
  width: 54rpx;
  height: 54rpx;
  margin: 0;
  padding: 0;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f4ead8;
  color: #111111;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1;
}

.week-pill-title {
  color: #111111;
  font-size: 30rpx;
  font-weight: 950;
  line-height: 36rpx;
}

.icon-btn {
  width: 73rpx;
  height: 73rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f7f7f3;
  color: #111111;
  transition:
    transform 120ms ease,
    opacity 120ms ease;
}

.search-icon {
  position: relative;
  width: 29rpx;
  height: 29rpx;
  border: 4rpx solid #111111;
  border-radius: 50%;
}

.search-icon::after {
  content: "";
  position: absolute;
  right: -10rpx;
  bottom: -6rpx;
  width: 15rpx;
  height: 4rpx;
  border-radius: 999rpx;
  background: #111111;
  transform: rotate(45deg);
}

.calendar-icon {
  position: relative;
  width: 32rpx;
  height: 32rpx;
  border: 4rpx solid #111111;
  border-radius: 8rpx;
}

.calendar-icon::before {
  content: "";
  position: absolute;
  left: -4rpx;
  right: -4rpx;
  top: 7rpx;
  height: 4rpx;
  background: #111111;
}

.calendar-icon::after {
  content: "";
  position: absolute;
  left: 6rpx;
  top: 18rpx;
  width: 4rpx;
  height: 4rpx;
  border-radius: 50%;
  background: #111111;
  box-shadow:
    10rpx 0 0 #111111,
    0 8rpx 0 #111111,
    10rpx 8rpx 0 #111111;
}

.summary-card,
.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  box-sizing: border-box;
}

.summary-card {
  margin: -3rpx 0 28rpx;
  padding: 24rpx;
  border-radius: 35rpx;
  background: #111111;
  color: #ffffff;
  box-shadow: 0 28rpx 56rpx rgba(36, 30, 18, 0.14);
}

.summary-label {
  display: inline-flex;
  align-items: center;
  height: 34rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: #b7ff38;
  color: #102006;
  font-size: 19rpx;
  font-weight: 950;
  line-height: 34rpx;
}

.summary-title {
  display: block;
  margin-top: 16rpx;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 34rpx;
}

.summary-desc {
  display: block;
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.72);
  font-size: 21rpx;
  line-height: 30rpx;
}

.summary-action {
  flex-shrink: 0;
  border-radius: 999rpx;
  font-size: 21rpx;
  font-weight: 900;
  line-height: 25rpx;
}

.summary-action {
  width: auto;
  height: 56rpx;
  padding: 0 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.12);
  color: #b7ff38;
}

.books-section {
  margin: 0 0 28rpx;
}

.section-head {
  margin-bottom: 17rpx;
}

.section-title {
  color: #151712;
  font-size: 30rpx;
  font-weight: 950;
  line-height: 36rpx;
}

.manage-button {
  height: 64rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: rgba(255, 255, 255, 0.86);
  color: #6f6254;
  font-size: 23rpx;
  font-weight: 900;
  line-height: 28rpx;
}

.manage-chevron {
  font-size: 26rpx;
  line-height: 1;
}

.book-scroll {
  width: 100%;
  white-space: nowrap;
}

.book-strip {
  display: inline-flex;
  gap: 17rpx;
  padding: 0 0 5rpx;
}

.book-tile {
  width: 182rpx;
  min-height: 218rpx;
  overflow: hidden;
  border: 2rpx solid #eee4d3;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.9);
  box-shadow: 0 17rpx 38rpx rgba(96, 72, 35, 0.08);
}

.book-tile-image {
  display: block;
  width: 182rpx;
  height: 126rpx;
  border-radius: 0;
  background: #f0e6d7;
}

.empty-book {
  background: linear-gradient(135deg, #efe7d8, #ffffff);
}

.book-tile-title,
.book-tile-count {
  display: block;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.book-tile-title {
  margin-top: 14rpx;
  padding: 0 16rpx;
  color: #151712;
  font-size: 23rpx;
  font-weight: 950;
  line-height: 28rpx;
}

.book-tile-count {
  margin-top: 5rpx;
  padding: 0 16rpx;
  color: #9a8064;
  font-size: 19rpx;
  font-weight: 900;
  line-height: 23rpx;
}

.state {
  margin-top: 24rpx;
  border-radius: 20rpx;
  padding: 20rpx;
  background: #f5f2ea;
  color: #777b72;
  font-size: 26rpx;
}

.state.error {
  background: #fff0ed;
  color: #b4442f;
}

.day-list {
  margin-top: 28rpx;
}

.day-section {
  margin-bottom: 24rpx;
}

.day-card {
  display: block;
  width: 100%;
  min-height: 196rpx;
  margin-top: 14rpx;
  border: 2rpx solid #eee4d3;
  border-radius: 42rpx;
  padding: 17rpx;
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 17rpx 38rpx rgba(96, 72, 35, 0.08);
}

.day-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.day-name {
  font-size: 28rpx;
  font-weight: 950;
  line-height: 34rpx;
}

.day-count {
  color: #9a8064;
  font-size: 21rpx;
  font-weight: 700;
  line-height: 25rpx;
}

.day-content {
  display: grid;
  grid-template-columns: 158rpx 1fr auto;
  align-items: center;
  gap: 28rpx;
}

.cover-stack {
  position: relative;
  width: 146rpx;
  height: 146rpx;
  flex-shrink: 0;
}

.cover-image {
  position: absolute;
  width: 123rpx;
  height: 140rpx;
  left: 0;
  top: 0;
  border: 5rpx solid #ffffff;
  border-radius: 23rpx;
  background: #eef1e8;
  box-shadow: 0 14rpx 31rpx rgba(70, 52, 24, 0.15);
}

.cover-md {
  box-sizing: border-box;
  padding: 12rpx 10rpx;
  overflow: hidden;
  text-align: left;
  background: linear-gradient(160deg, #ffffff 0%, #fbfaf6 58%, #eee9df 100%);
  color: #211f1a;
}

.cover-md::after {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 62rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0), #ffffff 86%);
}

.cover-md-title,
.cover-md-summary {
  display: block;
  overflow: hidden;
  word-break: break-all;
}

.cover-md-title {
  position: relative;
  z-index: 1;
  max-height: 38rpx;
  color: #151712;
  font-size: 16rpx;
  font-weight: 900;
  line-height: 18rpx;
}

.cover-md-summary {
  position: relative;
  z-index: 1;
  margin-top: 6rpx;
  max-height: 64rpx;
  color: #8b8a82;
  font-size: 14rpx;
  line-height: 18rpx;
}

.stack-0 {
  z-index: 3;
  transform: translate(26rpx, 6rpx) rotate(5deg);
}

.stack-1 {
  z-index: 2;
  transform: translate(13rpx, 3rpx) rotate(0deg);
}

.stack-2 {
  z-index: 1;
  transform: translate(0, 0) rotate(-5deg);
}

.more-count {
  position: absolute;
  right: -6rpx;
  top: -6rpx;
  z-index: 4;
  border-radius: 999rpx;
  min-width: 52rpx;
  height: 52rpx;
  padding: 0 7rpx;
  box-sizing: border-box;
  border: 4rpx solid #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #111111;
  color: #b7ff38;
  font-size: 19rpx;
  font-weight: 900;
  line-height: 1;
}

.cover-text {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 10rpx;
  min-width: 0;
  text-align: left;
  transform: translateY(-1rpx);
}

.type-pill {
  display: block;
  width: auto;
  height: 31rpx;
  padding: 0 11rpx;
  box-sizing: border-box;
  border-radius: 14rpx;
  background: #f2e5ce;
  color: #936a29;
  font-size: 18rpx;
  font-weight: 900;
  line-height: 31rpx;
}

.type-icon {
  display: block;
  font-size: 24rpx;
  line-height: 1;
}

.picture-icon {
  position: relative;
  width: 32rpx;
  height: 28rpx;
  border: 4rpx solid #b7ff38;
  border-radius: 8rpx;
  overflow: hidden;
}

.picture-sun {
  position: absolute;
  right: 5rpx;
  top: 5rpx;
  width: 7rpx;
  height: 7rpx;
  border-radius: 50%;
  background: #b7ff38;
}

.picture-mountain {
  position: absolute;
  left: 4rpx;
  bottom: 3rpx;
  width: 22rpx;
  height: 14rpx;
  background: #b7ff38;
  transform: skewX(-26deg) rotate(4deg);
  transform-origin: left bottom;
}

.md-pill {
  background: #ead8bd;
  color: #9a6f32;
}

.cover-title,
.cover-tags {
  display: block;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.cover-title {
  margin-top: 0;
  font-size: 33rpx;
  font-weight: 900;
  line-height: 40rpx;
}

.cover-tags {
  margin-top: 0;
  color: #8d7d69;
  font-size: 23rpx;
  line-height: 28rpx;
}

.chevron {
  justify-self: end;
  color: #9aa093;
  font-size: 33rpx;
  line-height: 1;
}

.empty-day {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  height: 112rpx;
  margin-top: 18rpx;
  border: 2rpx dashed #d8ddcf;
  border-radius: 24rpx;
  color: #6f7d63;
  font-size: 23rpx;
  font-weight: 800;
}

.empty-day-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
  border-radius: 14rpx;
  background: #ecffd8;
  color: #132006;
  font-size: 20rpx;
  font-weight: 900;
}

.upload-fab {
  position: fixed;
  right: 34rpx;
  bottom: calc(150rpx + env(safe-area-inset-bottom));
  width: 101rpx;
  height: 101rpx;
  border-radius: 38rpx;
  background: #111111;
  color: #b7ff38;
  box-shadow: 0 31rpx 59rpx rgba(0, 0, 0, 0.24);
  font-size: 49rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  transition:
    transform 120ms ease,
    opacity 120ms ease;
}

.upload-fab text {
  display: block;
  line-height: 1;
  transform: translateY(-3rpx);
}

.week-sheet-backdrop {
  position: fixed;
  inset: 0;
  z-index: 50;
  display: flex;
  align-items: flex-end;
  background: rgba(17, 17, 17, 0.28);
}

.week-sheet {
  position: relative;
  width: 100%;
  box-sizing: border-box;
  border-radius: 58rpx 58rpx 0 0;
  padding: 46rpx 38rpx 54rpx;
  background: #ffffff;
  box-shadow: 0 -24rpx 70rpx rgba(32, 24, 13, 0.14);
}

.sheet-close {
  position: absolute;
  right: 30rpx;
  top: 30rpx;
  width: 56rpx;
  height: 56rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f7f7f2;
  color: #111111;
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1;
}

.week-sheet-title {
  display: block;
  color: #111111;
  font-size: 44rpx;
  line-height: 52rpx;
  font-weight: 950;
}

.week-sheet-desc {
  display: block;
  margin: 10rpx 80rpx 28rpx 0;
  color: #7d8178;
  font-size: 24rpx;
  line-height: 36rpx;
}

.week-options {
  display: grid;
  gap: 16rpx;
}

.week-option {
  min-height: 104rpx;
  border: 2rpx solid transparent;
  border-radius: 34rpx;
  background: #f7f7f2;
}

.week-option.active {
  border-color: #b7ff38;
  background: #f7ffe9;
}

.week-select {
  width: 100%;
  min-height: 104rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 16rpx 20rpx 16rpx 24rpx;
  box-sizing: border-box;
}

.week-option-title,
.week-option-range {
  display: block;
}

.week-option-title {
  color: #111111;
  font-size: 27rpx;
  line-height: 34rpx;
  font-weight: 950;
}

.week-option-range {
  margin-top: 5rpx;
  color: #7d8178;
  font-size: 22rpx;
  line-height: 28rpx;
}

.week-option-count {
  flex-shrink: 0;
  min-width: 78rpx;
  height: 44rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #111111;
  color: #b7ff38;
  font-size: 20rpx;
  line-height: 24rpx;
  font-weight: 950;
}

.week-current-button {
  width: 100%;
  height: 78rpx;
  margin-top: 24rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #111111;
  color: #ffffff;
  font-size: 26rpx;
  line-height: 32rpx;
  font-weight: 950;
}

/* 新增灵感册卡片 */
.new-book-tile {
  background: #fff5e7;
  border: 2rpx dashed #f0d8b0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.new-tile-icon {
  font-size: 38rpx;
  line-height: 1;
  color: #8a5a16;
  font-weight: 300;
}

.new-tile-label {
  margin-top: 12rpx;
  font-size: 23rpx;
  font-weight: 900;
  color: #8a5a16;
  text-align: center;
}

.new-tile-sub {
  margin-top: 5rpx;
  font-size: 19rpx;
  font-weight: 800;
  color: #b07a40;
  text-align: center;
}

/* 预览页能力图标缩小适配 4 列 */
.item-icon {
  width: 36rpx;
  height: 36rpx;
  font-size: 18rpx;
}

.item-title {
  font-size: 24rpx;
}

.item-desc {
  font-size: 19rpx;
}
