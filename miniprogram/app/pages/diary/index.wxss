.page {
  min-height: 100vh;
  padding: 28rpx 28rpx 180rpx;
  box-sizing: border-box;
  background: #fffaf3;
  color: #151712;
}

button {
  box-sizing: border-box;
  padding: 0;
  background: transparent;
  text-align: left;
}

button::after {
  border: 0;
}

.button-press {
  opacity: 0.82;
  transform: scale(0.96);
}

.diary-preview {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.preview-hero {
  position: relative;
  min-height: 340rpx;
  overflow: hidden;
  border-radius: 36rpx;
  padding: 38rpx;
  background: linear-gradient(118deg, #eaf1ff 0%, #d9d0ff 46%, #c8e8ff 100%);
}

.eyebrow,
.caption {
  display: block;
  color: #5b49bf;
  font-size: 24rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}

.title {
  display: block;
  width: 410rpx;
  margin-top: 16rpx;
  color: #171736;
  font-size: 50rpx;
  font-weight: 900;
  line-height: 1.1;
}

.desc {
  display: block;
  width: 430rpx;
  margin-top: 18rpx;
  color: rgba(33, 32, 72, 0.66);
  font-size: 26rpx;
  line-height: 1.45;
}

.primary-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 190rpx;
  height: 72rpx;
  margin-top: 28rpx;
  border-radius: 999rpx;
  background: #b7ff38;
  color: #132006;
  font-size: 28rpx;
  font-weight: 900;
  text-align: center;
}

.preview-stack {
  position: absolute;
  right: 22rpx;
  top: 42rpx;
  width: 220rpx;
  height: 210rpx;
}

.stack-card {
  position: absolute;
  width: 116rpx;
  height: 148rpx;
  border: 8rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 24rpx;
  box-shadow: 0 20rpx 44rpx rgba(61, 55, 139, 0.22);
}

.stack-card.first {
  left: 0;
  top: 26rpx;
  transform: rotate(-9deg);
  background: linear-gradient(150deg, #5d7c68, #d7f2ea);
}

.stack-card.second {
  left: 74rpx;
  top: 0;
  transform: rotate(8deg);
  background: linear-gradient(150deg, #2d334d, #f2c6a0);
}

.stack-card.third {
  left: 44rpx;
  top: 88rpx;
  transform: rotate(2deg);
  background: linear-gradient(150deg, #20251f, #b7ff38);
}

.preview-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18rpx;
}

.preview-item {
  min-height: 154rpx;
  border-radius: 24rpx;
  padding: 24rpx;
  background: #ffffff;
  box-shadow: 0 14rpx 34rpx rgba(20, 24, 18, 0.08);
}

.item-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 42rpx;
  height: 42rpx;
  border-radius: 14rpx;
  background: #ecffd8;
  color: #2b4b16;
  font-size: 22rpx;
  font-weight: 900;
  text-align: center;
}

.item-title,
.item-desc {
  display: block;
}

.item-title {
  margin-top: 16rpx;
  font-size: 30rpx;
  font-weight: 900;
}

.item-desc {
  margin-top: 6rpx;
  color: #777b72;
  font-size: 24rpx;
}

.weekly-layout {
  padding-bottom: 130rpx;
}

.week-switcher {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 76rpx;
  margin-bottom: 22rpx;
  padding: 0 18rpx;
  border: 2rpx solid #eadcc8;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.78);
}

.week-nav {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f0e6d7;
  color: #111111;
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1;
}

.week-pill-title {
  color: #111111;
  font-size: 30rpx;
  font-weight: 950;
}

.icon-btn {
  width: 84rpx;
  height: 84rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f0f2ea;
  color: #111111;
  transition: transform 120ms ease, opacity 120ms ease;
}

.search-icon {
  position: relative;
  width: 34rpx;
  height: 34rpx;
  border: 6rpx solid #111111;
  border-radius: 50%;
}

.search-icon::after {
  content: "";
  position: absolute;
  right: -12rpx;
  bottom: -8rpx;
  width: 18rpx;
  height: 6rpx;
  border-radius: 999rpx;
  background: #111111;
  transform: rotate(45deg);
}

.summary-card,
.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  box-sizing: border-box;
}

.summary-card {
  min-height: 176rpx;
  padding: 28rpx;
  border-radius: 28rpx;
  background: #151712;
  color: #ffffff;
}

.summary-label {
  display: block;
  font-size: 23rpx;
  font-weight: 800;
}

.summary-label {
  display: inline-flex;
  align-items: center;
  height: 40rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: #b7ff38;
  color: #102006;
}

.summary-title {
  display: block;
  margin-top: 18rpx;
  font-size: 32rpx;
  font-weight: 900;
}

.summary-desc {
  display: block;
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.68);
  font-size: 24rpx;
}

.summary-action {
  flex-shrink: 0;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 900;
}

.summary-action {
  width: 74rpx;
  height: 74rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #b7ff38;
  color: #132006;
}

.books-section {
  margin-top: 30rpx;
}

.section-head {
  margin-bottom: 18rpx;
}

.section-title {
  color: #151712;
  font-size: 34rpx;
  font-weight: 950;
}

.manage-button {
  height: 64rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: rgba(255, 255, 255, 0.86);
  color: #6f6254;
  font-size: 26rpx;
  font-weight: 900;
}

.manage-chevron {
  font-size: 36rpx;
  line-height: 1;
}

.book-scroll {
  width: 100%;
  white-space: nowrap;
}

.book-strip {
  display: inline-flex;
  gap: 20rpx;
  padding: 0 2rpx 8rpx;
}

.book-tile {
  width: 166rpx;
  padding: 10rpx;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 28rpx rgba(85, 63, 31, 0.1);
}

.book-tile-image {
  width: 146rpx;
  height: 104rpx;
  border-radius: 16rpx;
  background: #f0e6d7;
}

.empty-book {
  background: linear-gradient(135deg, #efe7d8, #ffffff);
}

.book-tile-title,
.book-tile-count {
  display: block;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.book-tile-title {
  margin-top: 14rpx;
  color: #151712;
  font-size: 26rpx;
  font-weight: 950;
}

.book-tile-count {
  margin-top: 6rpx;
  color: #9a8064;
  font-size: 22rpx;
  font-weight: 900;
}

.state {
  margin-top: 24rpx;
  border-radius: 20rpx;
  padding: 20rpx;
  background: #f5f2ea;
  color: #777b72;
  font-size: 26rpx;
}

.state.error {
  background: #fff0ed;
  color: #b4442f;
}

.day-list {
  margin-top: 26rpx;
}

.day-card {
  display: block;
  width: 100%;
  margin-bottom: 20rpx;
  border-radius: 30rpx;
  padding: 24rpx 20rpx;
  box-sizing: border-box;
  background: #ffffff;
  box-shadow: 0 16rpx 40rpx rgba(85, 63, 31, 0.1);
}

.day-title-row,
.day-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.day-name {
  font-size: 32rpx;
  font-weight: 950;
}

.day-count {
  color: #777b72;
  font-size: 24rpx;
}

.day-content {
  margin-top: 22rpx;
  gap: 26rpx;
}

.cover-stack {
  position: relative;
  width: 154rpx;
  height: 154rpx;
  flex-shrink: 0;
}

.cover-image {
  position: absolute;
  width: 124rpx;
  height: 134rpx;
  border: 6rpx solid #ffffff;
  border-radius: 20rpx;
  background: #eef1e8;
  box-shadow: 0 12rpx 26rpx rgba(85, 63, 31, 0.18);
}

.stack-0 {
  left: 18rpx;
  top: 12rpx;
  z-index: 3;
  transform: rotate(-4deg);
}

.stack-1 {
  left: 6rpx;
  top: 4rpx;
  z-index: 2;
  transform: rotate(-8deg);
}

.stack-2 {
  left: 0;
  top: 18rpx;
  z-index: 1;
  transform: rotate(-12deg);
}

.more-count {
  position: absolute;
  right: 0;
  top: 0;
  z-index: 4;
  border-radius: 999rpx;
  min-width: 46rpx;
  height: 46rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #111111;
  color: #b7ff38;
  font-size: 22rpx;
  font-weight: 900;
}

.cover-text {
  flex: 1;
  min-width: 0;
}

.type-pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: auto;
  height: 36rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  background: #ead8bd;
  color: #9a6f32;
  font-size: 22rpx;
  font-weight: 900;
}

.type-icon {
  display: block;
  font-size: 24rpx;
  line-height: 1;
}

.picture-icon {
  position: relative;
  width: 32rpx;
  height: 28rpx;
  border: 4rpx solid #b7ff38;
  border-radius: 8rpx;
  overflow: hidden;
}

.picture-sun {
  position: absolute;
  right: 5rpx;
  top: 5rpx;
  width: 7rpx;
  height: 7rpx;
  border-radius: 50%;
  background: #b7ff38;
}

.picture-mountain {
  position: absolute;
  left: 4rpx;
  bottom: 3rpx;
  width: 22rpx;
  height: 14rpx;
  background: #b7ff38;
  transform: skewX(-26deg) rotate(4deg);
  transform-origin: left bottom;
}

.md-pill {
  background: #ead8bd;
  color: #9a6f32;
}

.cover-title,
.cover-tags {
  display: block;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.cover-title {
  margin-top: 14rpx;
  font-size: 32rpx;
  font-weight: 900;
}

.cover-tags {
  margin-top: 16rpx;
  color: #777b72;
  font-size: 24rpx;
}

.chevron {
  color: #9aa093;
  font-size: 46rpx;
}

.empty-day {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  height: 112rpx;
  margin-top: 18rpx;
  border: 2rpx dashed #d8ddcf;
  border-radius: 24rpx;
  color: #6f7d63;
  font-size: 26rpx;
  font-weight: 800;
}

.empty-day-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
  border-radius: 14rpx;
  background: #ecffd8;
  color: #132006;
  font-size: 28rpx;
  font-weight: 900;
}

.upload-fab {
  position: fixed;
  right: 34rpx;
  bottom: 52rpx;
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: #b7ff38;
  color: #132006;
  box-shadow: 0 18rpx 40rpx rgba(84, 118, 20, 0.28);
  font-size: 58rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 120ms ease, opacity 120ms ease;
}

.upload-fab text {
  display: block;
  line-height: 1;
  transform: translateY(-3rpx);
}
