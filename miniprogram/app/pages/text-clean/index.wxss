.text-page { min-height:100vh; padding:28rpx 31rpx 120rpx; box-sizing:border-box; background:#fff; color:#151712; }
button { margin:0; padding:0; border:0; line-height:1; }
button::after { border:0; }
.hero-card { position:relative; overflow:hidden; min-height:210rpx; padding:34rpx; box-sizing:border-box; border-radius:34rpx; background:linear-gradient(118deg,#e9edff,#ded4ff 52%,#d9f8ec); }
.hero-card::after { content:""; position:absolute; right:-25rpx; top:-70rpx; width:240rpx; height:230rpx; border-radius:76rpx; background:rgba(183,255,56,.38); transform:rotate(13deg); }
.hero-kicker,.hero-title,.hero-desc { position:relative; z-index:1; display:block; }
.hero-kicker { color:#5742c8; font-size:20rpx; line-height:24rpx; font-weight:900; }
.hero-title { margin-top:12rpx; font-size:49rpx; line-height:55rpx; font-weight:950; }
.hero-desc { width:440rpx; margin-top:13rpx; color:rgba(28,27,62,.62); font-size:21rpx; line-height:29rpx; }
.editor-head { display:flex; align-items:center; justify-content:space-between; margin:34rpx 0 16rpx; }
.section-title,.section-desc { display:block; }
.section-title { font-size:29rpx; line-height:35rpx; font-weight:950; }
.section-desc { margin-top:5rpx; color:#858a81; font-size:17rpx; line-height:22rpx; }
.head-actions { display:flex; gap:9rpx; }
.head-button,.reuse-button { display:flex; align-items:center; justify-content:center; padding:13rpx 18rpx; border-radius:999rpx; background:#f2f3ee; color:#646960; font-size:18rpx; font-weight:850; }
.text-box { position:relative; min-height:300rpx; padding:20rpx 20rpx 45rpx; box-sizing:border-box; border-radius:27rpx; background:#f7f7f4; }
.text-input { width:100%; min-height:250rpx; color:#191b17; font-size:23rpx; line-height:34rpx; }
.text-count { position:absolute; right:18rpx; bottom:14rpx; color:#92978e; font-size:16rpx; }
.action-title { display:block; margin-top:31rpx; }
.action-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:11rpx; margin-top:16rpx; }
.action-button { display:flex; align-items:center; min-height:72rpx; padding:0 17rpx; border-radius:21rpx; background:#f5f6f1; color:#252822; font-size:19rpx; font-weight:850; text-align:left; }
.action-button.recommended { background:#dfffaa; color:#111; }
.action-icon { flex:0 0 45rpx; color:#6cac08; font-size:25rpx; font-weight:950; text-align:center; }
.result-head { margin-top:34rpx; }
.result-box { background:linear-gradient(145deg,#f1ffdd,#fbfff5); }
.copy-button { display:flex; align-items:center; justify-content:center; width:100%; min-height:88rpx; margin-top:20rpx; border-radius:27rpx; background:#111; color:#b7ff38; font-size:25rpx; font-weight:950; }
