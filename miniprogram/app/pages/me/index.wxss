.page {
  min-height: 100vh;
  padding: 31rpx 31rpx 170rpx;
  background: #ffffff;
  color: #151712;
  box-sizing: border-box;
}

.me-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 31rpx;
}

.eyebrow,
.page-title,
.name,
.desc,
.num,
.label,
.banner-title,
.banner-desc,
.menu-title,
.menu-desc {
  display: block;
}

.eyebrow {
  color: #8b916f;
  font-size: 21rpx;
  font-weight: 800;
  letter-spacing: 0;
}

.page-title {
  margin-top: 6rpx;
  font-size: 42rpx;
  font-weight: 900;
  line-height: 1.1;
}

.top-dot {
  width: 73rpx;
  height: 73rpx;
  border-radius: 28rpx;
  background: #f4f5ef;
  position: relative;
}

.top-dot::after {
  content: "";
  position: absolute;
  left: 25rpx;
  top: 25rpx;
  width: 23rpx;
  height: 23rpx;
  border-radius: 50%;
  background: #b7ff38;
}

.profile {
  display: flex;
  align-items: center;
  gap: 28rpx;
  margin: 21rpx 0 38rpx;
}

.avatar {
  flex: 0 0 auto;
  width: 136rpx;
  height: 136rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #111111, #3e4930);
  color: #b7ff38;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 42rpx;
  font-weight: 900;
  box-shadow: 0 20rpx 48rpx rgba(17, 17, 17, 0.18);
}

.profile-copy {
  min-width: 0;
  flex: 1;
}

.name {
  font-size: 42rpx;
  font-weight: 900;
  line-height: 1.15;
  word-break: break-all;
}

.desc {
  margin-top: 10rpx;
  color: #787d73;
  font-size: 24rpx;
  line-height: 1.45;
}

.stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 17rpx;
  margin-bottom: 28rpx;
}

.stat-block {
  min-height: 112rpx;
  padding: 16rpx 14rpx;
  border-radius: 8rpx;
  background: #f7f8f4;
  box-sizing: border-box;
}

.num {
  font-size: 42rpx;
  font-weight: 900;
  line-height: 1;
}

.label {
  margin-top: 5rpx;
  color: #7c8178;
  font-size: 24rpx;
  line-height: 1.2;
}

.account-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 17rpx;
  margin-bottom: 21rpx;
  padding: 21rpx;
  border-radius: 10rpx;
  background: #f2ffe2;
  border: 1rpx solid #def4bd;
}

.account-banner.warn {
  background: #fff6e5;
  border-color: #f0dfbd;
}

.banner-title {
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1.25;
}

.banner-desc {
  margin-top: 8rpx;
  color: #767b70;
  font-size: 21rpx;
  line-height: 1.35;
}

.banner-button {
  flex: 0 0 auto;
  min-width: 150rpx;
  height: 63rpx;
  margin: 0;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: #b7ff38;
  color: #142006;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 63rpx;
}

.banner-button.dark {
  background: #111111;
  color: #b7ff38;
}

.banner-button::after {
  border: 0;
}

.debug-login {
  margin-bottom: 21rpx;
  padding: 21rpx;
  border-radius: 10rpx;
  border: 1rpx solid #eeeeea;
  background: #ffffff;
}

.debug-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.debug-title,
.debug-desc {
  display: block;
}

.debug-title {
  color: #151712;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1.25;
}

.debug-desc {
  margin-top: 8rpx;
  color: #7c8178;
  font-size: 21rpx;
  line-height: 1.35;
}

.debug-chevron {
  flex: 0 0 auto;
  color: #6f7668;
  font-size: 21rpx;
  font-weight: 800;
}

.debug-form {
  margin-top: 22rpx;
  display: grid;
  gap: 16rpx;
}

.debug-input {
  height: 70rpx;
  padding: 0 22rpx;
  border-radius: 8rpx;
  background: #f7f8f4;
  color: #151712;
  font-size: 23rpx;
  box-sizing: border-box;
}

.debug-button {
  height: 70rpx;
  margin: 0;
  border-radius: 8rpx;
  background: #111111;
  color: #b7ff38;
  font-size: 23rpx;
  font-weight: 900;
  line-height: 70rpx;
}

.debug-button::after {
  border: 0;
}

.menu-list {
  overflow: hidden;
  border-radius: 8rpx;
  border: 1rpx solid #eeeeea;
  background: #ffffff;
}

.menu-row {
  min-height: 92rpx;
  padding: 17rpx 21rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid #eeeeea;
  box-sizing: border-box;
}

.menu-row:last-child {
  border-bottom: 0;
}

.menu-title {
  font-size: 25rpx;
  font-weight: 800;
  line-height: 1.2;
}

.menu-desc {
  margin-top: 8rpx;
  color: #8b9087;
  font-size: 20rpx;
  line-height: 1.25;
}

.chevron {
  margin-left: 20rpx;
  color: #b2b6ad;
  font-size: 32rpx;
  line-height: 1;
}
