.page {
  min-height: 100vh;
  padding: 31rpx 31rpx 170rpx;
  background: #ffffff;
  color: #151712;
  box-sizing: border-box;
}

.me-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 31rpx;
}

.eyebrow,
.page-title,
.name,
.desc,
.num,
.label,
.banner-title,
.banner-desc,
.me-card-icon,
.me-card-title,
.me-card-desc {
  display: block;
}

.eyebrow {
  color: #8b916f;
  font-size: 21rpx;
  font-weight: 800;
  letter-spacing: 0;
}

.page-title {
  margin-top: 6rpx;
  font-size: 42rpx;
  font-weight: 900;
  line-height: 1.1;
}

.top-dot {
  width: 73rpx;
  height: 73rpx;
  border-radius: 28rpx;
  background: #f4f5ef;
  position: relative;
}

.top-dot::after {
  content: "";
  position: absolute;
  left: 25rpx;
  top: 25rpx;
  width: 23rpx;
  height: 23rpx;
  border-radius: 50%;
  background: #b7ff38;
}

.profile {
  display: grid;
  grid-template-columns: 136rpx 1fr;
  align-items: center;
  gap: 28rpx;
  margin: 21rpx 0 38rpx;
}

.avatar {
  width: 136rpx;
  height: 136rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #111111, #3e4930);
  color: #b7ff38;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 42rpx;
  font-weight: 900;
  box-shadow: 0 20rpx 48rpx rgba(17, 17, 17, 0.18);
  overflow: hidden;
}

.avatar image {
  width: 100%;
  height: 100%;
  display: block;
}

.profile-copy {
  min-width: 0;
}

.name {
  font-size: 42rpx;
  font-weight: 900;
  line-height: 1.15;
  word-break: break-all;
}

.desc {
  margin-top: 10rpx;
  color: #787d73;
  font-size: 24rpx;
  line-height: 1.45;
}

.stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 17rpx;
  margin-bottom: 28rpx;
}

.stat-block {
  display: grid;
  gap: 5rpx;
}

.num {
  font-size: 42rpx;
  font-weight: 900;
  line-height: 1;
}

.label {
  color: #7c8178;
  font-size: 24rpx;
  line-height: 1.2;
}

.account-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 17rpx;
  margin-bottom: 21rpx;
  padding: 21rpx;
  border-radius: 10rpx;
  background: #f2ffe2;
  border: 1rpx solid #def4bd;
}

.account-banner.warn {
  background: #fff6e5;
  border-color: #f0dfbd;
}

.banner-title {
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1.25;
}

.banner-desc {
  margin-top: 8rpx;
  color: #767b70;
  font-size: 21rpx;
  line-height: 1.35;
}

.banner-button {
  flex: 0 0 auto;
  min-width: 150rpx;
  height: 63rpx;
  margin: 0;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: #b7ff38;
  color: #142006;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 63rpx;
}

.banner-button.dark {
  background: #111111;
  color: #b7ff38;
}

.banner-button::after {
  border: 0;
}

.debug-login {
  margin-bottom: 21rpx;
  padding: 21rpx;
  border-radius: 10rpx;
  border: 1rpx solid #eeeeea;
  background: #ffffff;
}

.debug-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.debug-title,
.debug-desc {
  display: block;
}

.debug-title {
  color: #151712;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1.25;
}

.debug-desc {
  margin-top: 8rpx;
  color: #7c8178;
  font-size: 21rpx;
  line-height: 1.35;
}

.debug-chevron {
  flex: 0 0 auto;
  color: #6f7668;
  font-size: 21rpx;
  font-weight: 800;
}

.debug-form {
  margin-top: 22rpx;
  display: grid;
  gap: 16rpx;
}

.debug-input {
  height: 70rpx;
  padding: 0 22rpx;
  border-radius: 8rpx;
  background: #f7f8f4;
  color: #151712;
  font-size: 23rpx;
  box-sizing: border-box;
}

.debug-button {
  height: 70rpx;
  margin: 0;
  border-radius: 8rpx;
  background: #111111;
  color: #b7ff38;
  font-size: 23rpx;
  font-weight: 900;
  line-height: 70rpx;
}

.debug-button::after {
  border: 0;
}

.smart-card {
  margin-bottom: 24rpx;
  padding: 24rpx;
  border-radius: 10rpx;
  border: 1rpx solid #eeeeea;
  background: #fbfbf7;
}

.smart-head,
.smart-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.smart-head {
  margin-bottom: 0;
}

.smart-title,
.smart-desc,
.smart-row-title,
.smart-row-desc,
.smart-saving {
  display: block;
}

.smart-title {
  font-size: 26rpx;
  font-weight: 900;
  line-height: 1.25;
}

.smart-desc {
  margin-top: 8rpx;
  color: #7c8178;
  font-size: 21rpx;
  line-height: 1.35;
}

.smart-saving {
  flex: 0 0 auto;
  color: #6f7668;
  font-size: 20rpx;
  font-weight: 800;
}

.smart-head-action {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.smart-toggle {
  display: block;
  min-width: 72rpx;
  height: 48rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: #111111;
  color: #b7ff38;
  font-size: 20rpx;
  font-weight: 900;
  line-height: 48rpx;
  text-align: center;
}

.smart-settings-body {
  margin-top: 10rpx;
}

.smart-row {
  min-height: 88rpx;
  border-top: 1rpx solid #eeeeea;
}

.smart-row-title {
  color: #151712;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1.25;
}

.smart-row-desc {
  margin-top: 6rpx;
  color: #80847c;
  font-size: 21rpx;
  line-height: 1.25;
}

.tag-entry-card {
  width: 100%;
  min-height: 136rpx;
  margin: 0 0 24rpx;
  padding: 24rpx;
  border-radius: 10rpx;
  border: 1rpx solid #eeeeea;
  background: #fbfbf7;
  color: #151712;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  text-align: left;
  box-sizing: border-box;
}

.tag-entry-card::after {
  border: 0;
}

.tag-entry-title,
.tag-entry-desc,
.tag-entry-meta,
.tag-entry-action {
  display: block;
}

.tag-entry-title {
  font-size: 26rpx;
  font-weight: 900;
  line-height: 1.25;
}

.tag-entry-desc {
  margin-top: 8rpx;
  color: #7c8178;
  font-size: 21rpx;
  line-height: 1.35;
}

.tag-entry-meta {
  margin-top: 12rpx;
  color: #5a6f2d;
  font-size: 20rpx;
  font-weight: 900;
  line-height: 1.2;
}

.tag-entry-action {
  flex: 0 0 auto;
  min-width: 92rpx;
  height: 58rpx;
  border-radius: 999rpx;
  background: #f2ffe2;
  color: #445125;
  font-size: 21rpx;
  font-weight: 900;
  line-height: 58rpx;
  text-align: center;
}

.me-cards {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 21rpx;
}

.me-card {
  min-height: 146rpx;
  margin: 0;
  padding: 24rpx;
  border-radius: 10rpx;
  background: #f8f8f8;
  color: #151712;
  display: grid;
  grid-template-columns: 52rpx 1fr;
  column-gap: 17rpx;
  text-align: left;
  box-sizing: border-box;
}

.me-card::after,
.profile-tab::after {
  border: 0;
}

.me-card-icon {
  grid-row: 1 / span 2;
  width: 52rpx;
  height: 52rpx;
  color: #111111;
  position: relative;
  align-self: start;
}

.icon-file {
  width: 34rpx;
  height: 42rpx;
  margin: 5rpx 9rpx;
  border: 4rpx solid #111111;
  border-radius: 4rpx;
  box-sizing: border-box;
}

.icon-file::before {
  content: "";
  position: absolute;
  right: -4rpx;
  top: -4rpx;
  width: 13rpx;
  height: 13rpx;
  border-left: 4rpx solid #111111;
  border-bottom: 4rpx solid #111111;
  background: #f8f8f8;
}

.icon-file::after {
  content: "";
  position: absolute;
  left: 7rpx;
  top: 17rpx;
  width: 14rpx;
  height: 4rpx;
  background: #111111;
  box-shadow: 0 10rpx 0 #111111;
}

.icon-download::before {
  content: "";
  position: absolute;
  left: 23rpx;
  top: 4rpx;
  width: 5rpx;
  height: 29rpx;
  border-radius: 999rpx;
  background: #111111;
}

.icon-download::after {
  content: "";
  position: absolute;
  left: 15rpx;
  top: 21rpx;
  width: 18rpx;
  height: 18rpx;
  border-left: 5rpx solid #111111;
  border-bottom: 5rpx solid #111111;
  transform: rotate(-45deg);
}

.me-card-title {
  align-self: end;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 1.2;
}

.me-card-desc {
  grid-column: 2;
  margin-top: 7rpx;
  color: #80847c;
  font-size: 21rpx;
  line-height: 1.2;
}

.profile-tabs {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  margin: 49rpx 0 21rpx;
  border-bottom: 1rpx solid #eeeeee;
}

.profile-tab {
  position: relative;
  height: 84rpx;
  margin: 0;
  padding: 0;
  background: transparent;
  color: #888b84;
  font-size: 33rpx;
  font-weight: 900;
  line-height: 84rpx;
}

.profile-tab.active {
  color: #111111;
}

.profile-tab.active::before {
  content: "";
  position: absolute;
  left: 50%;
  bottom: 0;
  width: 80rpx;
  height: 7rpx;
  transform: translateX(-50%);
  border-radius: 999rpx;
  background: #111111;
}

.section-state {
  display: grid;
  gap: 10rpx;
  padding: 54rpx 20rpx;
  color: #8a8e84;
  font-size: 24rpx;
  line-height: 1.4;
  text-align: center;
}

.section-state text {
  display: block;
}

.section-list {
  display: grid;
  gap: 18rpx;
}

.book-section {
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14rpx;
}

.book-section .section-state {
  grid-column: 1 / -1;
}

.book-row {
  width: 100%;
  min-width: 0;
  margin: 0;
  padding: 0;
  overflow: hidden;
  border-radius: 10rpx;
  background: #f8f8f4;
  color: #151712;
  text-align: left;
  box-sizing: border-box;
}

.favorite-row {
  width: 100%;
  min-height: 142rpx;
  margin: 0;
  padding: 16rpx;
  border-radius: 10rpx;
  background: #f8f8f4;
  color: #151712;
  display: grid;
  grid-template-columns: 112rpx minmax(0, 1fr);
  gap: 18rpx;
  text-align: left;
  box-sizing: border-box;
}

.book-row::after,
.favorite-row::after,
.draft-item::after {
  border: 0;
}

.book-cover {
  width: 100%;
  height: 220rpx;
  aspect-ratio: 1;
  overflow: hidden;
  background: #ebe8dc;
}

.favorite-thumb {
  width: 112rpx;
  height: 112rpx;
  overflow: hidden;
  border-radius: 8rpx;
  background: #ebe8dc;
}

.favorite-thumb image {
  width: 100%;
  height: 100%;
  display: block;
}

.empty-cover,
.md-mini {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #6d725f;
  font-size: 21rpx;
  font-weight: 900;
}

.book-copy {
  min-width: 0;
  padding: 14rpx 12rpx 16rpx;
}

.book-title,
.book-meta {
  display: block;
  overflow: hidden;
}

.book-title {
  min-height: 60rpx;
  color: #151712;
  font-size: 23rpx;
  font-weight: 900;
  line-height: 30rpx;
  word-break: break-all;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.book-meta {
  margin-top: 8rpx;
  color: #5f6f30;
  font-size: 19rpx;
  font-weight: 800;
  line-height: 1.2;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.row-copy {
  min-width: 0;
  display: grid;
  align-content: center;
  gap: 8rpx;
}

.row-title,
.row-desc,
.row-meta {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.row-title {
  color: #151712;
  font-size: 27rpx;
  font-weight: 900;
  line-height: 1.25;
}

.row-desc {
  color: #777d70;
  font-size: 22rpx;
  line-height: 1.25;
}

.row-meta {
  color: #5f6f30;
  font-size: 20rpx;
  font-weight: 800;
  line-height: 1.2;
}

.draft-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.draft-grid .section-state {
  grid-column: 1 / -1;
}

.draft-item {
  margin: 0;
  padding: 0;
  overflow: hidden;
  border-radius: 10rpx;
  background: #f8f8f4;
  color: #151712;
  text-align: left;
}

.draft-item image,
.draft-thumb-empty {
  width: 100%;
  height: 220rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ebe8dc;
  color: #6d725f;
  font-size: 22rpx;
  font-weight: 900;
}

.draft-copy {
  padding: 16rpx;
}

.draft-title,
.draft-meta {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.draft-title {
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1.25;
}

.draft-meta {
  margin-top: 8rpx;
  color: #7c8178;
  font-size: 20rpx;
}

.favorite-row {
  position: relative;
  grid-template-columns: 112rpx minmax(0, 1fr) 42rpx;
  align-items: center;
}

.favorite-mark {
  color: #111111;
  font-size: 32rpx;
  font-weight: 900;
  text-align: center;
}

.page-state {
  padding: 28rpx 0;
  color: #858a80;
  font-size: 23rpx;
  text-align: center;
}
