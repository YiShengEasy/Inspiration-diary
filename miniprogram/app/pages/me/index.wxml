<view class="page me-page">
  <view class="me-top">
    <view>
      <text class="eyebrow">PROFILE</text>
      <text class="page-title">我的</text>
    </view>
    <view class="top-dot"></view>
  </view>

  <view class="profile">
    <view class="avatar">
      <image wx:if="{{profile.avatarUrl}}" src="{{profile.avatarUrl}}" mode="aspectFill"></image>
      <text wx:else>{{profile.avatarText}}</text>
    </view>
    <view class="profile-copy">
      <text class="name">{{profile.name}}</text>
      <text class="desc">{{profile.description}}</text>
    </view>
  </view>

  <view class="stats">
    <view class="stat-block">
      <text class="num">{{stats.inspirationCount}}</text>
      <text class="label">灵感数</text>
    </view>
    <view class="stat-block">
      <text class="num">{{stats.weekRecordCount}}</text>
      <text class="label">本周记录</text>
    </view>
    <view class="stat-block">
      <text class="num">{{stats.toolUsageCount}}</text>
      <text class="label">工具使用</text>
    </view>
  </view>

  <view wx:if="{{accountState === 'guest'}}" class="account-banner">
    <view>
      <text class="banner-title">登录后可保存灵感</text>
      <text class="banner-desc">同步作品、原图和每日灵感册。</text>
    </view>
    <button class="banner-button" loading="{{loading}}" bindtap="login">微信登录</button>
  </view>

  <view wx:if="{{accountState === 'guest'}}" class="debug-login">
    <view class="debug-head" bindtap="toggleDebugLogin">
      <view>
        <text class="debug-title">调试邮箱登录</text>
        <text class="debug-desc">开发调试时用 Web 账号直接进入。</text>
      </view>
      <text class="debug-chevron">{{debugLoginOpen ? '收起' : '展开'}}</text>
    </view>

    <view wx:if="{{debugLoginOpen}}" class="debug-form">
      <input class="debug-input" value="{{debugIdentifier}}" placeholder="邮箱或手机号" bindinput="onDebugIdentifierInput" />
      <input class="debug-input" value="{{debugPassword}}" password placeholder="密码" bindinput="onDebugPasswordInput" />
      <button class="debug-button" loading="{{debugLoading}}" bindtap="debugPasswordLogin">登录调试账号</button>
    </view>
  </view>

  <view wx:if="{{accountState === 'wechat_logged_in_unregistered'}}" class="account-banner warn">
    <view>
      <text class="banner-title">还差一步完成注册</text>
      <text class="banner-desc">绑定手机号或邮箱并设置 Web 登录密码。</text>
    </view>
    <button class="banner-button dark" bindtap="completeRegistration">完成注册</button>
  </view>

  <view class="smart-card">
    <view class="smart-head">
      <view>
        <text class="smart-title">自动入库</text>
        <text class="smart-desc">上传后匹配灵感册，确认后自动收录。</text>
      </view>
      <text wx:if="{{smartSettingsSaving}}" class="smart-saving">同步中</text>
    </view>

    <view class="smart-row">
      <view>
        <text class="smart-row-title">图片灵感</text>
        <text class="smart-row-desc">根据图片标签匹配灵感册</text>
      </view>
      <switch
        checked="{{smartSuggestImages}}"
        disabled="{{accountState !== 'registered' || smartSettingsSaving}}"
        color="#111111"
        bindchange="toggleSmartSuggestImages"
      />
    </view>

    <view class="smart-row">
      <view>
        <text class="smart-row-title">文档手稿</text>
        <text class="smart-row-desc">根据文档标签匹配灵感册</text>
      </view>
      <switch
        checked="{{smartSuggestMarkdown}}"
        disabled="{{accountState !== 'registered' || smartSettingsSaving}}"
        color="#111111"
        bindchange="toggleSmartSuggestMarkdown"
      />
    </view>
  </view>

  <button class="tag-entry-card" bindtap="openCustomTags">
    <view>
      <text class="tag-entry-title">自定义标签库</text>
      <text class="tag-entry-desc">管理 AI 识别图片和文档时可参考的词。</text>
      <text class="tag-entry-meta">{{customTagLibraryEnabled ? customTagEnabledCount : 0}} / {{customTagTotalCount}} 个词参与识别</text>
    </view>
    <text class="tag-entry-action">进入</text>
  </button>

  <view class="me-cards">
    <button wx:for="{{meCards}}" wx:key="title" class="me-card">
      <text class="me-card-icon icon-{{item.iconKey}}"></text>
      <text class="me-card-title">{{item.title}}</text>
      <text class="me-card-desc">{{item.desc}}</text>
    </button>
  </view>

  <view class="profile-tabs">
    <button
      wx:for="{{profileTabs}}"
      wx:key="*this"
      class="profile-tab {{activeTab === item ? 'active' : ''}}"
      data-tab="{{item}}"
      bindtap="selectProfileTab"
    >
      {{item}}
    </button>
  </view>

  <view class="work-grid">
    <view wx:for="{{workImages}}" wx:key="*this" class="work-item">
      <image src="{{item}}" mode="aspectFill"></image>
      <text wx:if="{{index === 1}}" class="work-badge">草稿</text>
    </view>
  </view>
</view>
